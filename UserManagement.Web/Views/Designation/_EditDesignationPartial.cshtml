@using UserManagement.Data.Models
@model DesignationModel

@{
    Layout = null;
}

<div class="modal-header">

    <h5 class="modal-title" id="userEditModalLabel">
        Edit Designation: @Model.DesignationName
    </h5>

    <button type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close">
    </button>

</div>

<form id="updateDesignationForm"
      asp-action="LoadEditModal"
      asp-controller="Designation"
      method="post"
      autocomplete="off"
      novalidate>

    <input type="hidden" asp-for="Id" />

    <div class="modal-body">

        <!-- Designation Name -->
        <div class="mb-3 col-md-6">

            <label class="form-label">
                Designation Name <span class="text-danger">*</span>
            </label>

            <input type="text"
                   asp-for="DesignationName"
                   id="DesignationName"
                   class="form-control"
                   autocomplete="off" />

            <small id="designation-status"
                   class="text-danger validation-message d-none">
            </small>

        </div>

        <!-- Status -->
        <div class="mb-3 col-md-3">

            <label class="form-label">
                Status
            </label>

            <select id="Status"
                    asp-for="IsActive"
                    class="form-select">

                <option value="true">Active</option>
                <option value="false">Inactive</option>

            </select>

        </div>

    </div>

    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                class="btn btn-primary">
            Save Changes
        </button>

    </div>

</form>

<style>

    .validation-message {
        font-size: 13px;
        margin-top: 4px;
        display: block;
    }

    .select2-container {
        width: 100% !important;
    }

</style>

<!-- jQuery -->
<script src="~/assets/lib/jquery/jquery.min.js"></script>

<!-- SweetAlert -->
<script src="~/assets/js/sweetalert2.all.min.js"></script>

<!-- Select2 -->
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>

    // ============================================
    // SELECT2 INIT
    // ============================================

    $(document).ready(function () {

        var modal = $("#updateDesignationForm").closest(".modal");

        $("#Status").select2({
            placeholder: "Select Status",
            dropdownParent: modal,
            width: "100%"
        });

    });

    // ============================================
    // HELPERS
    // ============================================

    function showError(messageId, message) {

        $(messageId)
            .removeClass("d-none")
            .text(message);
    }

    function clearError(messageId) {

        $(messageId)
            .addClass("d-none")
            .text("");
    }

    // ============================================
    // DESIGNATION VALIDATION
    // ============================================

    let designationValid = true;

    let originalDesignation = $("#DesignationName").val().trim();

    $("#DesignationName").on("keyup blur", function () {

        let designation = $(this).val().trim();

        // Required
        if (designation === "") {

            showError(
                "#designation-status",
                "Designation Name is required."
            );

            designationValid = false;
            return;
        }

        // Min Length
        if (designation.length < 3) {

            showError(
                "#designation-status",
                "Minimum 3 characters required."
            );

            designationValid = false;
            return;
        }

        // Same value no need check
        if (designation === originalDesignation) {

            clearError("#designation-status");

            designationValid = true;
            return;
        }

        // Check existing designation
        $.ajax({

            url: "/Designation/CheckDesignationName",

            type: "POST",

            data: {
                designationName: designation
            },

            success: function (res) {

                if (res.exists) {

                    showError(
                        "#designation-status",
                        "Designation already exists."
                    );

                    designationValid = false;

                } else {

                    clearError("#designation-status");

                    designationValid = true;
                }

            },

            error: function () {

                showError(
                    "#designation-status",
                    "Unable to validate designation."
                );

                designationValid = false;
            }

        });

    });

    // ============================================
    // FORM SUBMIT
    // ============================================

    $("#updateDesignationForm").on("submit", function (e) {

        e.preventDefault();

        let designation = $("#DesignationName").val().trim();

        // Final Validation
        if (designation === "") {

            showError(
                "#designation-status",
                "Designation Name is required."
            );

            return;
        }

        if (designation.length < 3) {

            showError(
                "#designation-status",
                "Minimum 3 characters required."
            );

            return;
        }

        if (!designationValid) {
            return;
        }

        // ============================================
        // CONFIRM UPDATE
        // ============================================

        Swal.fire({

            title: "Update Designation?",

            icon: "warning",

            showCancelButton: true,

            confirmButtonText: "Yes, Update",

            cancelButtonText: "Cancel"

        }).then((result) => {

            if (!result.isConfirmed) {
                return;
            }

            Swal.fire({

                title: "Updating...",

                allowOutsideClick: false,

                didOpen: () => {
                    Swal.showLoading();
                }

            });

            $.ajax({

                url: "/Designation/LoadEditModal",

                type: "POST",

                data: $("#updateDesignationForm").serialize(),

                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                },

                success: function (response) {

                    Swal.close();

                    if (response.success) {

                        Swal.fire({

                            icon: "success",

                            title: response.message,

                            showConfirmButton: false,

                            timer: 1500

                        }).then(() => {

                            window.location.href = response.redirectUrl;

                        });

                    }
                    else {

                        Swal.fire({

                            icon: "error",

                            title: "Error",

                            text: response.message || "Failed to update designation."

                        });

                    }

                },

                error: function () {

                    Swal.fire({

                        icon: "error",

                        title: "Error",

                        text: "Something went wrong! Please try again."

                    });

                }

            });

        });

    });

</script>