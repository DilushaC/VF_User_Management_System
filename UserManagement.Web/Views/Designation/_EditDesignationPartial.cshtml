@using UserManagement.Data.Models
@model DesignationModel

@{
    Layout = null;
}

<style>
    .um-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.1rem 1.5rem;
        background: linear-gradient(135deg, #0B3D91 0%, #082c6b 100%);
        color: #fff;
        border-top-left-radius: .9rem;
        border-top-right-radius: .9rem;
    }

        .um-modal-header .modal-title {
            display: flex;
            align-items: center;
            gap: .6rem;
            margin: 0;
            font-size: 1.05rem;
            font-weight: 700;
            color: #fff;
        }

        .um-modal-header .btn-close {
            filter: brightness(0) invert(1);
            opacity: .85;
        }

            .um-modal-header .btn-close:hover {
                opacity: 1;
            }

    .um-modal-body {
        padding: 1.5rem;
    }

        .um-modal-body .form-label {
            font-weight: 600;
            font-size: .85rem;
            color: #1C2430;
        }

        .um-modal-body .form-control,
        .um-modal-body .form-select,
        .um-modal-body .select2-container .select2-selection--single {
            border: 1px solid #E4E8EE;
            border-radius: .55rem !important;
        }

            .um-modal-body .form-control:focus,
            .um-modal-body .form-select:focus {
                outline: none;
                border-color: #2D6FE0;
                box-shadow: 0 0 0 3px rgba(45,111,224,.1);
            }

        .um-modal-body .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #2D6FE0 !important;
            box-shadow: 0 0 0 3px rgba(45,111,224,.1);
        }

        .um-modal-body .validation-message {
            font-size: 13px;
            margin-top: 4px;
            display: block;
            color: #D6384A;
        }

    .um-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: .75rem;
        padding: 1.1rem 1.5rem;
        border-top: 1px solid #E4E8EE;
        background: #F4F6F9;
        border-bottom-left-radius: .9rem;
        border-bottom-right-radius: .9rem;
    }

    .um-modal-btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .6rem 1.2rem;
        border-radius: .6rem;
        background: #fff;
        border: 1px solid #E4E8EE;
        color: #64748B;
        font-weight: 600;
        font-size: .9rem;
    }

        .um-modal-btn-ghost:hover {
            color: #1C2430;
            border-color: #64748B;
        }

    .um-modal-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .6rem 1.3rem;
        border-radius: .6rem;
        background: #2D6FE0;
        border: none;
        color: #fff;
        font-weight: 700;
        font-size: .9rem;
        transition: background .12s ease, transform .12s ease;
    }

        .um-modal-btn-primary:hover {
            background: #0B3D91;
            transform: translateY(-1px);
            color: #fff;
        }

    .select2-container {
        width: 100% !important;
    }
</style>

<div class="um-modal-header">
    <h5 class="modal-title" id="userEditModalLabel">
        <i class="ri-suitcase-line"></i> Edit Designation: @Model.DesignationName
    </h5>

    <button type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close">
    </button>
</div>

<form id="updateDesignationForm"
      asp-action="LoadEditModal"
      asp-controller="Designation"
      method="post"
      autocomplete="off"
      novalidate>

    <input type="hidden" asp-for="Id" />

    <div class="um-modal-body">

        <!-- Designation Name -->
        <div class="mb-3 col-md-6">

            <label class="form-label">
                Designation Name <span class="text-danger">*</span>
            </label>

            <input type="text"
                   asp-for="DesignationName"
                   id="DesignationName"
                   class="form-control"
                   autocomplete="off" />

            <small id="designation-status"
                   class="text-danger validation-message d-none">
            </small>

        </div>

        <!-- Status -->
        <div class="mb-3 col-md-3">

            <label class="form-label">
                Status
            </label>

            <select id="Status"
                    asp-for="IsActive"
                    class="form-select">

                <option value="true">Active</option>
                <option value="false">Inactive</option>

            </select>

        </div>

    </div>

    <div class="um-modal-footer">

        <button type="button"
                class="um-modal-btn-ghost"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                class="um-modal-btn-primary">
            <i class="ri-save-line"></i> Save Changes
        </button>

    </div>

</form>

<!-- jQuery -->
<script src="~/assets/lib/jquery/jquery.min.js"></script>

<!-- SweetAlert -->
<script src="~/assets/js/sweetalert2.all.min.js"></script>

<!-- Select2 -->
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>

    $(document).ready(function () {

        var modal = $("#updateDesignationForm").closest(".modal");

        $("#Status").select2({
            placeholder: "Select Status",
            dropdownParent: modal,
            width: "100%"
        });

    });

    function showError(messageId, message) {
        $(messageId).removeClass("d-none").text(message);
    }

    function clearError(messageId) {
        $(messageId).addClass("d-none").text("");
    }

    let originalDesignation = $("#DesignationName").val().trim();

    // ==========================
    // LIVE VALIDATION (UI ONLY)
    // ==========================
    $("#DesignationName").on("keyup blur", function () {

        let designation = $(this).val().trim();

        if (designation === "") {
            showError("#designation-status", "Designation Name is required.");
            return;
        }

        if (designation.length < 3) {
            showError("#designation-status", "Minimum 3 characters required.");
            return;
        }

        if (designation === originalDesignation) {
            clearError("#designation-status");
            return;
        }

        $.ajax({
            url: "/Designation/CheckDesignationName",
            type: "POST",
            data: { designationName: designation },
            success: function (res) {

                if (res.exists) {
                    showError("#designation-status", "Designation already exists.");
                } else {
                    clearError("#designation-status");
                }
            },
            error: function () {
                showError("#designation-status", "Validation failed.");
            }
        });

    });

    // ==========================
    // FORM SUBMIT (FINAL VALIDATION FIX)
    // ==========================
    $("#updateDesignationForm").on("submit", function (e) {

        e.preventDefault();

        let designation = $("#DesignationName").val().trim();

        // ❌ ALWAYS BLOCK EMPTY
        if (designation === "") {
            showError("#designation-status", "Designation Name is required.");
            return;
        }

        // ❌ MIN LENGTH CHECK
        if (designation.length < 3) {
            showError("#designation-status", "Minimum 3 characters required.");
            return;
        }

        // ❌ OPTIONAL: block if same as original + empty logic already handled
        let ajaxUrl = "/Designation/CheckDesignationName";

        Swal.fire({
            title: "Update Designation?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, Update",
            cancelButtonText: "Cancel"
        }).then((result) => {

            if (!result.isConfirmed) return;

            Swal.fire({
                title: "Updating...",
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            $.ajax({
                url: "/Designation/LoadEditModal",
                type: "POST",
                data: $("#updateDesignationForm").serialize(),
                headers: { "X-Requested-With": "XMLHttpRequest" },

                success: function (response) {

                    Swal.close();

                    if (response.success) {

                        Swal.fire({
                            icon: "success",
                            title: response.message,
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            window.location.href = response.redirectUrl;
                        });

                    } else {

                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: response.message || "Update failed."
                        });

                    }
                },

                error: function () {

                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: "Something went wrong!"
                    });

                }
            });

        });

    });

</script>
