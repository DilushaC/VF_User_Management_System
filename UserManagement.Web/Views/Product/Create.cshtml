@model UserManagement.Data.Models.ProductModel

@{
    ViewData["Title"] = "Create Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="row p-2">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h3 class="header">@ViewData["Title"]</h3>
                    <br />
                    <form asp-action="Create" asp-controller="Product" method="post" id="RegisterForm" novalidate>
                        <fieldset>
                            <div class="row g-2">
                                <div class="mb-3 col-md-6 position-relative">
                                    <label asp-for="ProductName" class="form-label">Product Name</label>
                                    <input asp-for="ProductName" class="form-control round" required
                                           data-bs-toggle="tooltip" data-bs-placement="right" title="Product Name is required" />
                                    <span asp-validation-for="ProductName" class="invalid-tooltip">Product Name is required</span>
                                    <small id="productName-status"></small>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="mb-3 col-md-6 position-relative">
                                    <label asp-for="Description" class="form-label">Description</label>
                                    <textarea asp-for="Description" class="form-control round" required
                                              data-bs-toggle="tooltip" data-bs-placement="right" title="Description is required"></textarea>
                                    <span asp-validation-for="Description" class="invalid-tooltip">Description is required</span>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="mb-3 col-md-2">
                                    <label asp-for="IsActive" class="form-label">Active Status</label>
                                    <select asp-for="IsActive" class="form-select">
                                        <option value="true">Active</option>
                                        <option value="false">Inactive</option>
                                    </select>
                                    <span asp-validation-for="IsActive" class="text-danger"></span>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">Create Product</button>
                        </fieldset>
                    </form>
                </div> <!-- end card-body -->
            </div> <!-- end card-->
        </div> <!-- end col -->
    </div>
</div>
<!-- Load jQuery only ONCE -->
<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>
<!-- Load Select2 JS -->
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>
    let productNameValid = false;

    $("#ProductName").on('blur', function () {
    let productName = $(this).val().trim();

        if (productName.length < 3) {
            $("#productName-status").html(`<span style="color:gray;">Minimum 3 characters required</span>`);
            productNameValid = false;
            return;
        }

        $.ajax({
            url: '/Product/CheckProductName',
            type: 'POST',
            data: { productName: productName },
            success: function (res) {
                if (res.exists) {
                    productNameValid = false;
                    $("#productName-status").html(`<span style="color:red;">❌ Product already exists</span>`);
                } else {
                    productNameValid = true;
                    $("#productName-status").html(`<span style="color:green;">✔ Product available</span>`);
                }
            }
        });
    });
    $("#RegisterForm").on("submit", function (e) {
        e.preventDefault();
        let form = $(this)[0];

        if (!productNameValid) {
            Swal.fire({
                icon: 'error',
                title: 'Product Already Exists',
                text: 'Please choose another Product.'
            });
            return;
        }

        if (!form.checkValidity()) {
            $(this).addClass('was-validated');
            return;
        }
        Swal.fire({
            title: 'Create Product?',
            text: "Are you sure you want to create?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Save',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Saving...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                $.ajax({
                    url: '/Product/Create',
                    type: 'POST',
                    data: $("#RegisterForm").serialize(),
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: function (response) {
                        Swal.close();
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: response.message,
                                showConfirmButton: false,
                                timer: 1500
                            }).then(() => {
                                window.location.href = response.redirectUrl;
                                // Reset form and Select2 elements
                            });
                        } else if (response.redirectUrl) {
                            // Redirect if controller provides URL
                            window.location.href = response.redirectUrl;
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Failed to create product.'
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong! Please try again.'
                        });
                    }
                });
            }
        });
    });



</script>

