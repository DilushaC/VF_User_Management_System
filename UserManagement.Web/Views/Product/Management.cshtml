@using UserManagement.Data.Models
@{
    ViewData["Title"] = "Products Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Datatables css -->
<link href="~/assets/vendor/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet" type="text/css" />
<link href="~/assets/vendor/datatables.net-responsive-bs5/css/responsive.bootstrap5.min.css" rel="stylesheet" type="text/css" />
<link href="~/assets/vendor/datatables.net-fixedcolumns-bs5/css/fixedColumns.bootstrap5.min.css" rel="stylesheet" type="text/css" />
<link href="~/assets/vendor/datatables.net-fixedheader-bs5/css/fixedHeader.bootstrap5.min.css" rel="stylesheet" type="text/css" />
<link href="~/assets/vendor/datatables.net-buttons-bs5/css/buttons.bootstrap5.min.css" rel="stylesheet" type="text/css" />
<link href="~/assets/vendor/datatables.net-select-bs5/css/select.bootstrap5.min.css" rel="stylesheet" type="text/css" />

<!-- Theme Config Js -->
<script src="~/assets/js/config.js"></script>

<!-- App css -->
<link href="~/assets/css/app.min.css" rel="stylesheet" type="text/css" id="app-style" />

<!-- Icons css -->
<link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />

<div class="row p-2">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h3 class="page-title">@ViewData["Title"]</h3>
                <br />
                <div class="mb-3">
                    <a href="@Url.Action("Create", "Product")" class="btn btn-primary">
                        <i class="ri-shopping-cart-line"></i> Add Product
                    </a>
                </div>
                <div class="table-responsive">
                    <table id="basic-datatable" class="table table-striped dt-responsive nowrap w-100">
                        <thead>
                            <tr>
                                <th>Product Name</th>
                                <th>Active</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="productEditModal" tabindex="-1" aria-labelledby="productEditModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <!-- Initial loading content -->
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading product details...</p>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/vendor/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="~/assets/vendor/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
<script src="~/assets/vendor/datatables.net-select/js/dataTables.select.min.js"></script>
<script src="~/assets/vendor/datatables.net-keytable/js/dataTables.keyTable.min.js"></script>
<script src="~/assets/js/app.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>

<script>
    var table = $('#basic-datatable').DataTable({
        processing: true,
        serverSide: true,
        ajax: {
            url: '/Product/GetProductsPaged',
            type: 'POST'
        },
        columns: [
            { data: 'productName' },
            {
                data: 'isActive',
                render: function (data, type, row) {
                    if (data === true || data === "Active") {
                        return '<span class="badge bg-success">Active</span>';
                    } else {
                        return '<span class="badge bg-danger">Inactive</span>';
                    }
            },
            },
            // Actions
            {
                data: 'id',
                orderable: false,
                searchable: false,
                className: 'text-center',

                render: function (data) {
                    return `
                        <div class="d-flex justify-content-center gap-1">

                            <!-- Edit -->
                            <button type="button"
                                    class="btn btn-sm btn-info edit-product-btn"
                                    data-product-id="${data}"
                                    title="Edit Product">
                                <i class="bi bi-pencil"></i>
                            </button>

                            <!-- Delete -->
                            <button type="button"
                                    class="btn btn-sm btn-danger delete-product-btn"
                                    data-product-id="${data}"
                                    title="Delete Product">
                                <i class="bi bi-trash"></i>
                            </button>

                        </div>
                    `;
                }
            }
        ],
        pageLength: 10,
        lengthMenu: [10, 25, 50, 100],
        orderable: true
    });


</script>

<script>
    $(document).ready(function () {
        const productEditModal = new bootstrap.Modal(document.getElementById('productEditModal'));
        const modalContent = $('#productEditModal .modal-content');
        $('#basic-datatable').on('click', '.edit-product-btn', function () {
            const Id = $(this).data('product-id');

            if (!Id) {
                alert("Product ID is missing!");
                return;
            }
            modalContent.html(`
                <div class="modal-body text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading product details...</p>
                </div>
            `);

            productEditModal.show();
            const url = '@Url.Action("LoadEditModal", "Product")/' + Id;

            $.ajax({
                url: url,
                type: 'GET',
                cache: false,
                success: function (partialViewHtml) {
                    modalContent.html(partialViewHtml);
                },
                error: function (xhr, status, error) {
                    console.error("AJAX error:", status, error);
                    modalContent.html(`
                        <div class="modal-header">
                            <h5 class="modal-title text-danger">Error Loading Data</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="m-0">Failed to load user details. Server responded with: ${xhr.status} (${xhr.statusText})</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    `);
                }
            });
        });
    });


</script>

<script>

    // ── Delete Branch ─────────────────────────────────────────
    $('#basic-datatable').on('click', '.delete-product-btn', function () {

        const id = $(this).data('product-id');

        // Validate ID
        if (!id) {

            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Product ID not found.'
            });

            return;
        }

        // Confirmation Alert
        Swal.fire({

            title: 'Delete Product?',
            text: 'This action cannot be undone.',
            icon: 'warning',

            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',

            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel'

        }).then((result) => {

            // Cancel
            if (!result.isConfirmed)
                return;

            // Loading
            Swal.fire({
                title: 'Deleting...',
                text: 'Please wait',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // AJAX Delete
            $.ajax({

                url: '/Product/DeleteProduct',
                type: 'DELETE',

                data: {
                    id: id
                },

                success: function (response) {

                    Swal.close();

                    // Success
                    if (response.success) {

                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted',
                            text: response.message,
                            timer: 1500,
                            showConfirmButton: false
                        });

                        // Reload DataTable
                        table.ajax.reload(null, false);

                    }
                    else {

                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message || 'Failed to delete Product.'
                        });

                    }

                },

                error: function () {

                    Swal.fire({
                        icon: 'error',
                        title: 'Server Error',
                        text: 'Something went wrong while deleting.'
                    });

                }

            });

        });

    });

</script>


