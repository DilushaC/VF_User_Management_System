@model UserManagement.Data.Models.RolePagePermissionModel

@{
    ViewData["Title"] = "Create Role Page Permission";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <!-- start page title -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="javascript: void(0);">Access Management</a></li>
                        <li class="breadcrumb-item"><a href="javascript: void(0);">Role Page Permissions</a></li>
                        <li class="breadcrumb-item active">Create Role Page Permission</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!-- Form row -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h3 class="header">Create Role Page Permission</h3>
                    <br />
                    <form asp-action="Create" asp-controller="UserRole" method="post" id="RegisterForm">
                        <div class="row g-2">
                            <div class="mb-3 col-md-6">
                                <label asp-for="RoleId" class="form-label">Role Name</label>
                                <select id="RoleId"
                                        asp-for="RoleId"
                                        class="form-control select2"
                                        data-placeholder="Select Role"
                                        asp-items="ViewBag.Roles">
                                    <option></option>
                                </select>
                                <span asp-validation-for="RoleId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="mb-3 col-md-6">
                                <label asp-for="ProductId" class="form-label">Product Name</label>
                                <select id="ProductId"
                                        asp-for="ProductId"
                                        class="form-control select2"
                                        data-placeholder="Select Product"
                                        asp-items="ViewBag.Products">
                                    <option></option>
                                </select>
                                <span asp-validation-for="RoleId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="mb-3 col-md-6">
                                <label asp-for="PageIds" class="form-label">Page Name</label>
                                <select id="PageIds"
                                        name="PageIds"
                                        asp-for="PageIds"
                                        class="form-control select2"
                                        multiple="multiple"
                                        data-placeholder="Select Pages">
                                </select>
                                <span asp-validation-for="PageIds" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="mb-3 col-md-2">
                                <label asp-for="CanEdit" class="form-label">Can Edit</label>
                                <select asp-for="CanEdit" class="form-select">
                                    <option value="true">Yes</option>
                                    <option value="false">No</option>
                                </select>
                                <span asp-validation-for="CanEdit" class="text-danger"></span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">Create Permission</button>
                    </form>
                </div> <!-- end card-body -->
            </div> <!-- end card-->
        </div> <!-- end col -->
    </div>
</div>
<!-- Load jQuery only ONCE -->
<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>
<!-- Load Select2 JS -->
<script src="~/assets/vendor/select2/js/select2.min.js"></script>


<script>

    $("#RoleId").select2({
        placeholder: "Select RoleId",
    });
    $("#ProductId").select2({
        width: "100%",
    });
    $("#PageIds").select2({
        width: "100%",
        allowClear: true
    });

    $("#ProductId").on("change", function () {
    let productId = $(this).val();
        if (productId) {
            $.ajax({
                url: '/Permission/GetPagesByProduct',
                type: 'GET',
                data: { productId: productId },
                success: function (response) {
                    if (response.success) {
                        $("#PageIds").empty();
                        response.data.forEach(page => {
                            $("#PageIds").append(
                                new Option(page.pageName, page.id)
                            );
                        });
                        $("#PageIds").trigger('change');
                    }
                }
            });
        } else {
            $("#PageIds").empty().trigger('change');
        }
    });


    $("#RegisterForm").on("submit", function (e) {
    e.preventDefault(); // Stop default form submission
    let form = $(this);
        Swal.fire({
            title: 'Create Page Permission?',
            text: "Are you sure you want to create?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Save',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Saving...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                $.ajax({
                    url: '/Permission/Create',
                    type: 'POST',
                    data: form.serialize(),
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: function (response) {
                        Swal.close();
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: response.message,
                                showConfirmButton: false,
                                timer: 1500
                            }).then(() => {
                                window.location.href = response.redirectUrl;
                                // Reset form and Select2 elements
                            });
                        } else if (response.redirectUrl) {
                            // Redirect if controller provides URL
                            window.location.href = response.redirectUrl;
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Failed to create role.'
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong! Please try again.'
                        });
                    }
                });
            }
        });
    });



</script>

