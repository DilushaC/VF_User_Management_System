@model UserManagement.Data.Models.RolePagePermissionModel

@{
    ViewData["Title"] = "Create Page Permission for User Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row p-2">
    <div class="col-12">
        <div class="card">
            <div class="card-body">

                <h3 class="header">@ViewData["Title"]</h3>
                <br />

                <form asp-action="Create"
                      asp-controller="Permission"
                      method="post"
                      id="RegisterForm"
                      autocomplete="off"
                      novalidate>

                    <!-- Role -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="RoleId" class="form-label">Role Name</label>
                            <select asp-for="RoleId"
                                    class="form-control select2"
                                    asp-items="ViewBag.Roles"
                                    required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>

                    <!-- Products -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label class="form-label">Products</label>
                            <div class="list-group" id="productList">
                                @{
                                    var products = ViewBag.Products as IEnumerable<SelectListItem>
                                    ?? Enumerable.Empty<SelectListItem>();
                                }

                                @foreach (var product in products)
                                {
                                    <div class="list-group-item d-flex flex-column align-items-start">
                                        <div class="form-check w-100">
                                            <input type="checkbox" class="form-check-input product-checkbox"
                                                   value="@product.Value" id="product_@product.Value" />
                                            <label class="form-check-label fw-semibold"
                                                   for="product_@product.Value">
                                                @product.Text
                                            </label>
                                        </div>
                                        <!-- Pages dropdown container -->
                                        <div class="m-2 page-select-container"
                                             id="pagesContainer_@product.Value"
                                             style="display:none; width:100%;">
                                            <select class="form-control product-pages select2"
                                                    data-product="@product.Value"
                                                    multiple
                                                    style="width:100%;">
                                            </select>
                                        </div>
                                    </div>
                                }
                            </div>

                            <input type="hidden" id="ProductId" name="ProductId" />
                            <!-- Container for dynamically generated hidden inputs for PageIds -->
                            <div id="PageIdsContainer"></div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary mt-3">
                        Create Permission
                    </button>

                </form>
            </div>
        </div>
    </div>
</div>

<!-- CSS Fix for Select2 width -->
<style>
    .page-select-container {
        width: 100%;
    }

        .page-select-container .select2-container {
            width: 100% !important;
        }

    .product-pages {
        width: 100% !important;
    }
</style>

<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>
    $(".select2").select2({ width: "100%" });

    let selectedProducts = [];
    let selectedPages = {}; // productId -> [pageIds]

    // When a product checkbox is toggled
    $(document).on("change", ".product-checkbox", function () {
        const productId = $(this).val();
        const container = $(`#pagesContainer_${productId}`);

        if (this.checked) {
            selectedProducts.push(productId);
            container.show();
            loadPages(productId);
        } else {
            selectedProducts = selectedProducts.filter(p => p !== productId);
            delete selectedPages[productId];
            container.hide();
            container.find("select").val(null).trigger("change");
        }

        $("#ProductId").val(selectedProducts.join(","));
        updateHiddenPageIds();
    });

    // Load pages via AJAX
    function loadPages(productId) {
        const $select = $(`#pagesContainer_${productId} select`);
        $select.empty();

        $.ajax({
            url: "/Permission/GetPagesByProduct",
            type: "GET",
            data: { productId: productId },
            success: function (res) {
                if (!res.success) return;

                res.data.forEach(p => {
                    $select.append(new Option(p.pageName, p.id));
                });

                // Re-initialize Select2 with full width
                $select.select2({ width: "100%" });
                selectedPages[productId] = [];
            }
        });
    }

    // When pages are selected
    $(document).on("change", ".product-pages", function () {
        const productId = $(this).data("product");
        selectedPages[productId] = $(this).val() || [];
        updateHiddenPageIds();
    });

    // Update hidden inputs for PageIds (one input per page)
    function updateHiddenPageIds() {
        $("#PageIdsContainer").empty();

        Object.values(selectedPages).forEach(pageArray => {
            pageArray.forEach(pageId => {
                $("#PageIdsContainer").append(
                    `<input type="hidden" name="PageIds" value="${pageId}" />`
                );
            });
        });
    }

    // Form submit
    $("#RegisterForm").on("submit", function (e) {
        e.preventDefault();

        if (!this.checkValidity()) {
            $(this).addClass("was-validated");
            return;
        }

        Swal.fire({
            title: "Create Page Permission?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes"
        }).then(result => {
            if (!result.isConfirmed) return;

            $.ajax({
                url: "/Permission/Create",
                type: "POST",
                data: $(this).serialize(),
                    headers: { "X-Requested-With": "XMLHttpRequest" },

                    success: function (response) {
                        Swal.close();

                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: response.message,
                                showConfirmButton: false,
                                timer: 1500
                            }).then(() => {
                                window.location.href = response.redirectUrl;
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Failed to create menu.'
                            });
                        }
                    },

                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong! Please try again.'
                        });
                    }
            });
        });
    });
</script>
