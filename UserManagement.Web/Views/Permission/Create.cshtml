@model UserManagement.Data.Models.RolePagePermissionModel

@{
    ViewData["Title"] = "Create Page Permission for User Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row p-2">
    <div class="col-12">
        <div class="card">
            <div class="card-body">

                <h3 class="header">@ViewData["Title"]</h3>
                <br />

                <form asp-action="Create"
                      asp-controller="Permission"
                      method="post"
                      id="RegisterForm"
                      novalidate>

                    <!-- Role -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="RoleId" class="form-label">Role Name</label>
                            <select asp-for="RoleId"
                                    class="form-control select2"
                                    asp-items="ViewBag.Roles"
                                    required>
                                <option value="">Select Role</option>
                            </select>
                        </div>
                    </div>

                    <!-- Products -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label class="form-label">Products</label>

                            <div class="row g-3">
                                @{
                                    var products = ViewBag.Products as IEnumerable<SelectListItem>
                                        ?? Enumerable.Empty<SelectListItem>();
                                }

                                @foreach (var product in products)
                                {
                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input product-checkbox"
                                                   type="checkbox"
                                                   value="@product.Value"
                                                   id="product_@product.Value" />
                                            <label class="form-check-label fw-semibold"
                                                   for="product_@product.Value">
                                                @product.Text
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Backend compatibility -->
                            <input type="hidden" id="ProductId" name="ProductId" />
                        </div>
                    </div>

                    <!-- Product | Pages List -->
                    <div class="mt-4">
                        <h6 class="fw-bold mb-2">Product Page Permissions</h6>

                        <div class="table-responsive">
                            <table class="table table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:30%">Product</th>
                                        <th style="width:70%">Pages</th>
                                    </tr>
                                </thead>
                                <tbody id="productPageTable">
                                    <!-- Dynamic rows -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Hidden PageIds -->
                    <input type="hidden" id="PageIds" name="PageIds" />

                    <!-- Can Edit -->
                    <div class="row mt-3">
                        <div class="col-md-2">
                            <label asp-for="CanEdit" class="form-label">Can Edit</label>
                            <select asp-for="CanEdit" class="form-select">
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary mt-3">
                        Create Permission
                    </button>

                </form>
            </div>
        </div>
    </div>
</div>

<!-- Scripts -->
<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>

    /* ---------------- Init ---------------- */
    $(".select2").select2({ width: "100%" });

    let selectedProducts = [];
    let selectedPages = {}; // productId -> [pageIds]

    /* ---------------- Product Toggle ---------------- */
    $(document).on("change", ".product-checkbox", function () {

        const productId = $(this).val();
        const productName = $(this).next("label").text();

        if (this.checked) {
            selectedProducts.push(productId);
            addProductRow(productId, productName);
        } else {
            selectedProducts = selectedProducts.filter(p => p !== productId);
            delete selectedPages[productId];
            $("#row_" + productId).remove();
        }

        $("#ProductId").val(selectedProducts.join(","));
        updateHiddenPageIds();
    });

    /* ---------------- Add Row ---------------- */
    function addProductRow(productId, productName) {

        if ($("#row_" + productId).length) return;

        let rowHtml = `
            <tr id="row_${productId}">
                <td class="fw-semibold">${productName}</td>
                <td>
                    <select class="form-control product-pages select2"
                            data-product="${productId}"
                            multiple>
                    </select>
                </td>
            </tr>`;

        $("#productPageTable").append(rowHtml);

        loadPages(productId);
    }

    /* ---------------- Load Pages ---------------- */
    function loadPages(productId) {

        $.ajax({
            url: "/Permission/GetPagesByProduct",
            type: "GET",
            data: { productId: productId },
            success: function (res) {

                if (!res.success) return;

                const $select = $(`#row_${productId} select`);

                res.data.forEach(p => {
                    $select.append(new Option(p.pageName, p.id));
                });

                $select.select2({ width: "100%" });

                selectedPages[productId] = [];
            }
        });
    }

    /* ---------------- Page Change ---------------- */
    $(document).on("change", ".product-pages", function () {

        const productId = $(this).data("product");
        selectedPages[productId] = $(this).val() || [];
        updateHiddenPageIds();
    });

    /* ---------------- Merge Pages ---------------- */
    function updateHiddenPageIds() {

        let allPages = [];

        Object.values(selectedPages).forEach(p => {
            allPages.push(...p);
        });

        $("#PageIds").val(allPages.join(","));
    }

    /* ---------------- Submit ---------------- */
    $("#RegisterForm").on("submit", function (e) {
        e.preventDefault();

        if (!this.checkValidity()) {
            $(this).addClass("was-validated");
            return;
        }

        Swal.fire({
            title: "Create Page Permission?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes"
        }).then(result => {

            if (!result.isConfirmed) return;

            $.ajax({
                url: "/Permission/Create",
                type: "POST",
                data: $(this).serialize(),
                success: function (res) {

                    if (res.success) {
                        Swal.fire("Success", res.message, "success")
                            .then(() => window.location.href = res.redirectUrl);
                    } else {
                        Swal.fire("Error", res.message, "error");
                    }
                }
            });
        });
    });

</script>
