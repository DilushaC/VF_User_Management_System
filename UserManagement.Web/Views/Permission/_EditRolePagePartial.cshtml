@using UserManagement.Data.Models
@model RolePagePermissionModel

@{
    Layout = null;
    var products = ViewBag.Products as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="modal-header">
    <h5 class="modal-title">Edit User Role: @Model.RoleName</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form id="updatePagePermissionForm"
      asp-action="LoadEditModal"
      asp-controller="Permission"
      method="post">

    <input type="hidden" asp-for="RoleId" />

    <!-- Container for dynamically generated hidden inputs for PageIds -->
    <div id="PageIdsContainer"></div>

    <div class="modal-body">

        <!-- PRODUCTS + PAGES -->
        <div class="accordion" id="productAccordion">

            @if (products.Any())
            {
                foreach (var product in products)
                {
                    var productPages = ((IEnumerable<dynamic>)(product.Pages ?? Enumerable.Empty<dynamic>()));
                    bool productChecked = productPages.Any(pg => pg.IsAssigned != null && (bool)pg.IsAssigned);
                    var collapseClass = productChecked ? "show" : "";
                    var buttonClass = productChecked ? "" : "collapsed";
                    var ariaExpanded = productChecked ? "true" : "false";

                    <div class="accordion-item mb-2">
                        <h2 class="accordion-header" id="heading_@product.ProductId">
                            <button class="accordion-button @buttonClass"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#product_@product.ProductId"
                                    aria-expanded="@ariaExpanded"
                                    aria-controls="product_@product.ProductId">

                                <strong>@product.ProductName</strong>
                            </button>
                        </h2>

                        <div id="product_@product.ProductId"
                             class="accordion-collapse collapse @collapseClass"
                             aria-labelledby="heading_@product.ProductId"
                             data-bs-parent="#productAccordion">

                            <div class="accordion-body">
                                <select class="form-control select2 page-select"
                                        data-product="@product.ProductId"
                                        multiple="multiple"
                                        style="width:100%;">
                                    @foreach (var pg in productPages)
                                    {
                                        if (pg.IsAssigned != null && (bool)pg.IsAssigned)
                                        {
                                            <option value="@pg.PageId" selected>@pg.PageName</option>
                                        }
                                        else
                                        {
                                            <option value="@pg.PageId">@pg.PageName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning">No products/pages found.</div>
            }

        </div>

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>

</form>

<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/vendor/select2/js/select2.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>

<script>
    $(document).ready(function () {

        // Initialize Select2
        $('.select2').select2({ width: '100%' });

        // Accordion checkbox toggle
        $('.product-checkbox').on('click', function (e) {
            e.stopPropagation();
            const target = $(this).data('target');
            const collapseEl = $(target);

            if ($(this).is(':checked')) {
                collapseEl.collapse('show');
            } else {
                collapseEl.collapse('hide');
                collapseEl.find('select').val(null).trigger('change');
                updatePageIds();
            }
        });

        // Generate one hidden input per selected page
        function updatePageIds() {
            $('#PageIdsContainer').empty();
            $('.page-select').each(function() {
                const selected = $(this).val(); // array of strings
                if (selected && selected.length > 0) {
                    selected.forEach(function(pageId) {
                        $('#PageIdsContainer').append(
                            `<input type="hidden" name="PageIds" value="${pageId}" />`
                        );
                    });
                }
            });
        }

        // Trigger update on select2 change
        $(document).on('change', '.page-select', function() {
            updatePageIds();
        });

        // Initial update on page load (for preselected options)
        updatePageIds();

        // Form submit via AJAX
        $('#updatePagePermissionForm').on('submit', function(e) {
            e.preventDefault();

            if (!this.checkValidity()) {
                $(this).addClass('was-validated');
                return;
            }

            updatePageIds(); // ensure hidden inputs are up-to-date


            Swal.fire({
                title: "Update Role Permissions?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, Update"
            }).then(result => {
                if (!result.isConfirmed) return;

                $.ajax({
                    url: '/Permission/LoadEditModal',
                    type: 'POST',
                    data: $(this).serialize(), // PageIds[] will be sent as string array
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: function (response) {
                        Swal.close();

                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: response.message,
                                showConfirmButton: false,
                                timer: 1500
                            }).then(() => {
                                window.location.href = response.redirectUrl;
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Failed to create menu.'
                            });
                        }
                    },

                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong! Please try again.'
                        });
                    }
                });
            });

        });

    });
</script>
