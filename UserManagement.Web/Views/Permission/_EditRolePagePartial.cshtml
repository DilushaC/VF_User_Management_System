@using UserManagement.Data.Models
@model RolePagePermissionModel

@{
    Layout = null;
    var products = ViewBag.Products as IEnumerable<dynamic>;
}

<div class="modal-header">
    <h5 class="modal-title">Edit User Role: @Model.RoleName</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form id="updatePagePermissionForm"
      asp-action="LoadEditModal"
      asp-controller="Permission"
      method="post">

    <input type="hidden" asp-for="RoleId" />

    <div class="modal-body">

        <!-- ROLE NAME -->
        <div class="mb-3 col-md-6">
            <label class="form-label">Role Name</label>
            <input asp-for="RoleName" class="form-control" readonly />
        </div>

        <!-- PRODUCTS + PAGES -->
        <div class="accordion" id="productAccordion">

            @if (products != null)
            {
                foreach (var product in products)
                {
                    bool productChecked = false;
                    foreach (var pg in product.Pages)
                    {
                        if (pg.IsAssigned)
                        {
                            productChecked = true;
                            break;
                        }
                    }

                    var collapseClass = productChecked ? "show" : "";
                    var buttonClass = productChecked ? "" : "collapsed";
                    var ariaExpanded = productChecked ? "true" : "false";

                    <div class="accordion-item mb-2">
                        <h2 class="accordion-header" id="heading_@product.ProductId">
                            <button class="accordion-button @buttonClass"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#product_@product.ProductId"
                                    aria-expanded="@ariaExpanded"
                                    aria-controls="product_@product.ProductId">

                                <input type="checkbox"
                                       class="form-check-input me-2 product-checkbox"
                                       data-target="#product_@product.ProductId"
                                       @(productChecked ? "checked" : "") />

                                <strong>@product.ProductName</strong>
                            </button>
                        </h2>

                        <div id="product_@product.ProductId"
                             class="accordion-collapse collapse @collapseClass"
                             aria-labelledby="heading_@product.ProductId"
                             data-bs-parent="#productAccordion">

                            <div class="accordion-body">

                                <select class="form-control select2 page-select"
                                        name="PageIds"
                                        multiple>

                                    @foreach (var pg in product.Pages)
                                    {
                                        <option value="@pg.PageId"
                                                selected="@(pg.IsAssigned)">
                                            @pg.PageName
                                        </option>
                                    }


                                </select>

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning">
                    No products/pages found.
                </div>
            }

        </div>

        <!-- CAN EDIT -->
        <div class="mt-3 col-md-3">
            <label class="form-label">Can Edit</label>
            <select asp-for="CanEdit" class="form-select select2">
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
        </div>

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>

</form>

<script>
    $(document).ready(function () {

        $('.select2').select2({
            width: '100%'
        });

        // Prevent checkbox click from collapsing header
        $('.product-checkbox').on('click', function (e) {
            e.stopPropagation();

            const target = $(this).data('target');
            const collapseEl = $(target);

            if ($(this).is(':checked')) {
                collapseEl.collapse('show');
            } else {
                collapseEl.collapse('hide');
            }
        });

    });
</script>
