@using UserManagement.Data.Models
@model RolePagePermissionModel

@{
    Layout = null;
    var products = ViewBag.Products as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<style>
    .um-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.1rem 1.5rem;
        background: linear-gradient(135deg, #0B3D91 0%, #082c6b 100%);
        color: #fff;
        border-top-left-radius: .9rem;
        border-top-right-radius: .9rem;
    }

        .um-modal-header .modal-title {
            display: flex;
            align-items: center;
            gap: .6rem;
            margin: 0;
            font-size: 1.05rem;
            font-weight: 700;
            color: #fff;
        }

        .um-modal-header .btn-close {
            filter: brightness(0) invert(1);
            opacity: .85;
        }

            .um-modal-header .btn-close:hover {
                opacity: 1;
            }

    .um-modal-body {
        padding: 1.5rem;
        max-height: 65vh;
        overflow-y: auto;
    }

    .um-modal-subtitle {
        font-size: .82rem;
        color: #64748B;
        margin: 0 0 1.1rem;
    }

    /* ===== Themed accordion ===== */
    .um-accordion .accordion-item {
        border: 1px solid #E4E8EE;
        border-radius: .6rem !important;
        overflow: hidden;
        margin-bottom: .65rem;
    }

        .um-accordion .accordion-item:last-child {
            margin-bottom: 0;
        }

    .um-accordion .accordion-header {
        margin: 0;
    }

    .um-accordion .accordion-button {
        display: flex;
        align-items: center;
        gap: .6rem;
        padding: .85rem 1.1rem;
        font-weight: 700;
        font-size: .9rem;
        color: #1C2430;
        background: #fff;
        box-shadow: none !important;
    }

        .um-accordion .accordion-button::after {
            filter: invert(32%) sepia(75%) saturate(1884%) hue-rotate(205deg) brightness(93%) contrast(92%);
        }

        .um-accordion .accordion-button:not(.collapsed) {
            background: rgba(45,111,224,.08);
            color: #0B3D91;
        }

        .um-accordion .accordion-button:focus {
            box-shadow: none;
        }

    .um-accordion-ico {
        width: 30px;
        height: 30px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        border-radius: .5rem;
        background: rgba(45,111,224,.1);
        color: #2D6FE0;
        font-size: .95rem;
    }

    .um-accordion-badge {
        margin-left: auto;
        margin-right: .5rem;
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .15rem .55rem;
        border-radius: 999px;
        font-size: .7rem;
        font-weight: 700;
        color: #0E9F6E;
        background: rgba(14,159,110,.12);
    }

    .um-accordion .accordion-body {
        padding: 1rem 1.1rem 1.1rem;
        background: #F4F6F9;
        border-top: 1px solid #E4E8EE;
    }

    .um-accordion .select2-container .select2-selection--multiple {
        border: 1px solid #E4E8EE !important;
        border-radius: .55rem !important;
        min-height: 42px;
    }

    .um-accordion .select2-container--default.select2-container--focus .select2-selection--multiple {
        border-color: #2D6FE0 !important;
        box-shadow: 0 0 0 3px rgba(45,111,224,.1);
    }

    .um-accordion .select2-selection__choice {
        background: rgba(45,111,224,.1) !important;
        color: #0B3D91 !important;
        border: none !important;
        border-radius: .4rem !important;
    }

    .um-alert-warning {
        display: flex;
        align-items: center;
        gap: .6rem;
        padding: .9rem 1.1rem;
        border-radius: .6rem;
        background: rgba(217,119,6,.1);
        color: #92600a;
        font-size: .88rem;
        font-weight: 600;
    }

    .um-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: .75rem;
        padding: 1.1rem 1.5rem;
        border-top: 1px solid #E4E8EE;
        background: #F4F6F9;
        border-bottom-left-radius: .9rem;
        border-bottom-right-radius: .9rem;
    }

    .um-modal-btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .6rem 1.2rem;
        border-radius: .6rem;
        background: #fff;
        border: 1px solid #E4E8EE;
        color: #64748B;
        font-weight: 600;
        font-size: .9rem;
    }

        .um-modal-btn-ghost:hover {
            color: #1C2430;
            border-color: #64748B;
        }

    .um-modal-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .6rem 1.3rem;
        border-radius: .6rem;
        background: #2D6FE0;
        border: none;
        color: #fff;
        font-weight: 700;
        font-size: .9rem;
        transition: background .12s ease, transform .12s ease;
    }

        .um-modal-btn-primary:hover {
            background: #0B3D91;
            transform: translateY(-1px);
            color: #fff;
        }

    .select2-container {
        width: 100% !important;
    }
</style>

<div class="um-modal-header">
    <h5 class="modal-title"><i class="ri-shield-keyhole-line"></i> Edit User Role: @Model.RoleName</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form id="updatePagePermissionForm"
      asp-action="LoadEditModal"
      asp-controller="Permission"
      method="post"
      autocomplete="off">

    <input type="hidden" asp-for="RoleId" />

    <!-- Container for dynamically generated hidden inputs for PageIds -->
    <div id="PageIdsContainer"></div>

    <div class="um-modal-body">

        <p class="um-modal-subtitle">Expand a product to choose which pages this role can access.</p>

        <!-- PRODUCTS + PAGES -->
        <div class="accordion um-accordion" id="productAccordion">

            @if (products.Any())
            {
                foreach (var product in products)
                {
                    var productPages = ((IEnumerable<dynamic>)(product.Pages ?? Enumerable.Empty<dynamic>()));
                    int assignedCount = productPages.Count(pg => pg.IsAssigned != null && (bool)pg.IsAssigned);
                    bool productChecked = assignedCount > 0;
                    var collapseClass = productChecked ? "show" : "";
                    var buttonClass = productChecked ? "" : "collapsed";
                    var ariaExpanded = productChecked ? "true" : "false";

                    <div class="accordion-item mb-2">
                        <h2 class="accordion-header" id="heading_@product.ProductId">
                            <button class="accordion-button @buttonClass"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#product_@product.ProductId"
                                    aria-expanded="@ariaExpanded"
                                    aria-controls="product_@product.ProductId">

                                <span class="um-accordion-ico"><i class="ri-apps-2-line"></i></span>
                                <strong>@product.ProductName</strong>

                                @if (assignedCount > 0)
                                {
                                    <span class="um-accordion-badge"><i class="ri-checkbox-circle-fill"></i>@assignedCount selected</span>
                                }
                            </button>
                        </h2>

                        <div id="product_@product.ProductId"
                             class="accordion-collapse collapse @collapseClass"
                             aria-labelledby="heading_@product.ProductId"
                             data-bs-parent="#productAccordion">

                            <div class="accordion-body">
                                <select class="form-control select2 page-select"
                                        data-product="@product.ProductId"
                                        multiple="multiple"
                                        style="width:100%;">
                                    @foreach (var pg in productPages)
                                    {
                                        if (pg.IsAssigned != null && (bool)pg.IsAssigned)
                                        {
                                            <option value="@pg.PageId" selected>@pg.PageName</option>
                                        }
                                        else
                                        {
                                            <option value="@pg.PageId">@pg.PageName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="um-alert-warning"><i class="ri-error-warning-line"></i> No products/pages found.</div>
            }

        </div>

    </div>

    <div class="um-modal-footer">
        <button type="button" class="um-modal-btn-ghost" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="um-modal-btn-primary"><i class="ri-save-line"></i> Save Changes</button>
    </div>

</form>

<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/vendor/select2/js/select2.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>

<script>
    $(document).ready(function () {

        // Initialize Select2
        $('.select2').select2({ width: '100%' });

        // Accordion checkbox toggle
        $('.product-checkbox').on('click', function (e) {
            e.stopPropagation();
            const target = $(this).data('target');
            const collapseEl = $(target);

            if ($(this).is(':checked')) {
                collapseEl.collapse('show');
            } else {
                collapseEl.collapse('hide');
                collapseEl.find('select').val(null).trigger('change');
                updatePageIds();
            }
        });

        // Generate one hidden input per selected page
        function updatePageIds() {
            $('#PageIdsContainer').empty();
            $('.page-select').each(function() {
                const selected = $(this).val(); // array of strings
                if (selected && selected.length > 0) {
                    selected.forEach(function(pageId) {
                        $('#PageIdsContainer').append(
                            `<input type="hidden" name="PageIds" value="${pageId}" />`
                        );
                    });
                }
            });
        }

        // Trigger update on select2 change
        $(document).on('change', '.page-select', function() {
            updatePageIds();
        });

        // Initial update on page load (for preselected options)
        updatePageIds();

        // Form submit via AJAX
        $('#updatePagePermissionForm').on('submit', function(e) {
            e.preventDefault();

            if (!this.checkValidity()) {
                $(this).addClass('was-validated');
                return;
            }

            updatePageIds(); // ensure hidden inputs are up-to-date


            Swal.fire({
                title: "Update Role Permissions?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, Update"
            }).then(result => {
                if (!result.isConfirmed) return;

                $.ajax({
                    url: '/Permission/LoadEditModal',
                    type: 'POST',
                    data: $(this).serialize(), // PageIds[] will be sent as string array
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: function (response) {
                        Swal.close();

                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: response.message,
                                showConfirmButton: false,
                                timer: 1500
                            }).then(() => {
                                window.location.href = response.redirectUrl;
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Failed to create menu.'
                            });
                        }
                    },

                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong! Please try again.'
                        });
                    }
                });
            });

        });

    });
</script>
