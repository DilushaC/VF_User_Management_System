@model UserManagement.Data.Models.DepartmentModel

@{
    ViewData["Title"] = "Create Department";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Theme Config Js -->
<script src="~/assets/js/config.js"></script>

<!-- App css -->
<link href="~/assets/css/app.min.css" rel="stylesheet" type="text/css" id="app-style" />

<!-- Icons css -->
<link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />

<style>
    .um-page {
        --um-primary: #0B3D91;
        --um-primary-deep: #082c6b;
        --um-active: #2D6FE0;
        --um-active-soft: rgba(45,111,224,.1);
        --um-bg: #F4F6F9;
        --um-ash: #E4E8EE;
        --um-ink: #1C2430;
        --um-muted: #64748B;
        --um-ok: #0E9F6E;
        --um-bad: #D6384A;
        --um-card: #ffffff;
    }

    .um-page {
        background: var(--um-bg);
        padding: 1.5rem 0 2.5rem;
        color: var(--um-ink);
    }

    /* ===== Header bar ===== */
    .um-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.25rem;
        padding: 1.25rem 1.5rem;
        border-radius: .75rem;
        background: linear-gradient(135deg, var(--um-primary) 0%, var(--um-primary-deep) 100%);
        color: #fff;
    }

    .um-head-title {
        display: flex;
        align-items: center;
        gap: .85rem;
    }

    .um-head-ico {
        width: 44px;
        height: 44px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        border-radius: .65rem;
        background: rgba(255,255,255,.14);
        font-size: 1.3rem;
    }

    .um-head h3 {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 700;
        color: #fff;
    }

    .um-head p {
        margin: .15rem 0 0;
        font-size: .85rem;
        color: rgba(255,255,255,.72);
    }

    .um-back-btn {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .6rem 1.1rem;
        border-radius: .6rem;
        background: rgba(255,255,255,.14);
        color: #fff;
        font-weight: 600;
        font-size: .9rem;
        text-decoration: none;
        border: none;
        transition: background .12s ease, transform .12s ease;
    }

        .um-back-btn:hover {
            background: rgba(255,255,255,.24);
            color: #fff;
            transform: translateY(-1px);
        }

    /* ===== Stat strip ===== */
    .um-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: .9rem;
        margin-bottom: 1.25rem;
    }

    .um-stat {
        background: var(--um-card);
        border: 1px solid var(--um-ash);
        border-radius: .7rem;
        padding: .9rem 1.1rem;
        display: flex;
        align-items: center;
        gap: .75rem;
    }

    .um-stat-ico {
        width: 38px;
        height: 38px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        border-radius: .55rem;
        font-size: 1.05rem;
        background: var(--um-active-soft);
        color: var(--um-active);
    }

    .um-stat-num {
        font-size: 1.1rem;
        font-weight: 700;
        line-height: 1.1;
    }

    .um-stat-label {
        font-size: .78rem;
        color: var(--um-muted);
    }

    /* ===== Form card ===== */
    .um-card {
        background: var(--um-card);
        border: 1px solid var(--um-ash);
        border-radius: .8rem;
        overflow: hidden;
    }

    .um-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--um-ash);
    }

        .um-card-head h6 {
            margin: 0;
            font-weight: 700;
            font-size: .95rem;
        }

    .um-card-body {
        padding: 1.5rem;
    }

    .um-section-title {
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: var(--um-muted);
        margin: 0 0 1rem;
        padding-bottom: .5rem;
        border-bottom: 1px dashed var(--um-ash);
    }

    .um-section + .um-section {
        margin-top: 1.75rem;
    }

    .um-page .form-label {
        font-weight: 600;
        font-size: .85rem;
        color: var(--um-ink);
    }

    .um-page .form-control,
    .um-page .form-select,
    .um-page .select2-container .select2-selection--single {
        border: 1px solid var(--um-ash);
        border-radius: .55rem !important;
    }

        .um-page .form-control:focus,
        .um-page .form-select:focus {
            outline: none;
            border-color: var(--um-active);
            box-shadow: 0 0 0 3px var(--um-active-soft);
        }

    .um-page .select2-container--default.select2-container--focus .select2-selection--single,
    .um-page .select2-container--default .select2-selection--single:focus {
        border-color: var(--um-active) !important;
        box-shadow: 0 0 0 3px var(--um-active-soft);
    }

    .um-hint {
        font-size: .76rem;
        color: var(--um-muted);
        display: block;
        margin-top: .15rem;
    }

    .um-status {
        display: block;
        margin-top: .35rem;
        font-size: .8rem;
    }

    .um-card-footer {
        display: flex;
        justify-content: flex-end;
        gap: .75rem;
        padding: 1.1rem 1.5rem;
        border-top: 1px solid var(--um-ash);
        background: var(--um-bg);
    }

    .um-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .65rem 1.4rem;
        border-radius: .6rem;
        background: var(--um-active);
        border: none;
        color: #fff;
        font-weight: 700;
        font-size: .9rem;
        transition: background .12s ease, transform .12s ease;
    }

        .um-btn-primary:hover {
            background: var(--um-primary);
            transform: translateY(-1px);
        }

    .um-btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .65rem 1.3rem;
        border-radius: .6rem;
        background: #fff;
        border: 1px solid var(--um-ash);
        color: var(--um-muted);
        font-weight: 600;
        font-size: .9rem;
        text-decoration: none;
    }

        .um-btn-ghost:hover {
            color: var(--um-ink);
            border-color: var(--um-muted);
        }
</style>

<div class="um-page">
    <div class="container-fluid">

        <div class="um-head">
            <div class="um-head-title">
                <span class="um-head-ico"><i class="ri-organization-chart"></i></span>
                <div>
                    <h3>@ViewData["Title"]</h3>
                    <p>Add a new department for assigning to users and branches</p>
                </div>
            </div>
            <a href="@Url.Action("Management", "Department")" class="um-back-btn">
                <i class="ri-arrow-left-line"></i> Back to departments
            </a>
        </div>

        <form asp-action="Create" asp-controller="Department" method="post" id="RegisterForm" autocomplete="off" novalidate>
            <fieldset>
                <div class="um-card">
                    <div class="um-card-head">
                        <h6><i class="ri-organization-chart me-1" style="color:var(--um-active);"></i>Department details</h6>
                    </div>
                    <div class="um-card-body">

                        <div class="um-section">
                            <p class="um-section-title">Details</p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="DepartmentName" class="form-label">Department Name</label>
                                    <input asp-for="DepartmentName"
                                           id="DepartmentName"
                                           class="form-control"
                                           required
                                           autocomplete="off" />
                                    <small id="departmentName-status" class="um-status"></small>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="IsActive" class="form-label">Active Status</label>
                                    <select asp-for="IsActive" id="IsActive" class="form-select select2">
                                        <option value="true">Active</option>
                                        <option value="false">Inactive</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="um-card-footer">
                        <a href="@Url.Action("Management", "Department")" class="um-btn-ghost">Cancel</a>
                        <button type="submit" class="um-btn-primary"><i class="ri-save-line"></i> Create Department</button>
                    </div>
                </div>
            </fieldset>
        </form>

    </div>
</div>

<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>

    // ── Helper ────────────────────────────────────────────────────────────────
    function setMsg(id, text, isError) {
        $("#" + id).html(text
            ? '<span style="color:' + (isError ? 'var(--um-bad)' : 'var(--um-ok)') + ';">' +
              (isError ? '❌ ' : '✔ ') + text + '</span>'
            : '');
    }

    // ── Select2 Init ──────────────────────────────────────────────────────────
    $("#IsActive").select2({ placeholder: "Select Status" });

    // ── Tracking flag ─────────────────────────────────────────────────────────
    let departmentNameValid = false;

    // ── Department Name validation ────────────────────────────────────────────
    $("#DepartmentName").on('blur', function () {
        let departmentName = $(this).val().trim();

        if (departmentName.length === 0) {
            setMsg('departmentName-status', 'Department Name is required.', true);
            departmentNameValid = false;
            return;
        }

        if (departmentName.length < 2) {
            setMsg('departmentName-status', 'Minimum 2 characters required.', true);
            departmentNameValid = false;
            return;
        }

        $.ajax({
            url: '/Department/CheckDepartmentName',
            type: 'POST',
            data: { departmentName: departmentName },
            success: function (res) {
                if (res.exists) {
                    departmentNameValid = false;
                    setMsg('departmentName-status', 'Department already exists.', true);
                } else {
                    departmentNameValid = true;
                    setMsg('departmentName-status', 'Department name available.', false);
                }
            }
        });
    });

    // ── Form Submit ───────────────────────────────────────────────────────────
    $("#RegisterForm").on("submit", function (e) {
        e.preventDefault();

        let isValid = true;

        // Validate department name
        if ($("#DepartmentName").val().trim() === '') {
            setMsg('departmentName-status', 'Department Name is required.', true);
            departmentNameValid = false;
        }

        if (!departmentNameValid) isValid = false;

        if (!isValid) return;

        // Confirm then submit
        Swal.fire({
            title: 'Create Department?',
            text: 'Are you sure you want to create?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Save',
            cancelButtonText: 'Cancel'
        }).then((result) => {

            if (!result.isConfirmed) return;

            Swal.fire({
                title: 'Saving...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            $.ajax({
                url: '/Department/Create',
                type: 'POST',
                data: $("#RegisterForm").serialize(),
                headers: { "X-Requested-With": "XMLHttpRequest" },

                success: function (response) {
                    Swal.close();

                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: response.message,
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            window.location.href = response.redirectUrl;
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message || 'Failed to create department.'
                        });
                    }
                },

                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Something went wrong! Please try again.'
                    });
                }
            });
        });
    });

</script>
