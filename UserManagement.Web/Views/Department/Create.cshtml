@model UserManagement.Data.Models.DepartmentModel

@{
    ViewData["Title"] = "Create Department";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <!-- start page title -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="javascript: void(0);">Management</a></li>
                        <li class="breadcrumb-item"><a href="javascript: void(0);">Departments</a></li>
                        <li class="breadcrumb-item active">Create Department</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!-- Form row -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h3 class="header">@ViewData["Title"]</h3>
                    <br />
                    <form asp-action="Create" asp-controller="Department" method="post" id="RegisterForm" novalidate>
                        <div class="row g-2">
                            <div class="mb-3 col-md-6 position-relative">
                                <label asp-for="DepartmentName" class="form-label">Department Name</label>
                                <input asp-for="DepartmentName" class="form-control round" required
                                       data-bs-toggle="tooltip" data-bs-placement="right" title="Department Name is required" />
                                <span asp-validation-for="DepartmentName" class="invalid-tooltip">Department Name is required</span>
                                <small id="departmentName-status"></small>
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="mb-3 col-md-2 position-relative">
                                <label asp-for="IsActive" class="form-label">Active Status</label>
                                <select asp-for="IsActive" class="form-select select2">
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                                <span asp-validation-for="IsActive" class="invalid-tooltip">Active Status is required</span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">Create Department</button>
                    </form>
                </div> <!-- end card-body -->
            </div> <!-- end card-->
        </div> <!-- end col -->
    </div>
</div>
<!-- Load jQuery only ONCE -->
<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>
<!-- Load Select2 JS -->
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>
    let departmentNameValid = false;

    $("#DepartmentName").on('blur', function () {
    let departmentName = $(this).val().trim();

        if (departmentName.length < 2) {
            $("#departmentName-status").html(`<span style="color:gray;">Minimum 2 characters required</span>`);
            departmentNameValid = false;
            return;
        }

        $.ajax({
            url: '/Department/CheckDepartmentName',
            type: 'POST',
            data: { departmentName: departmentName },
            success: function (res) {
                if (res.exists) {
                    departmentNameValid = false;
                    $("#departmentName-status").html(`<span style="color:red;">❌ Department already exists</span>`);
                } else {
                    departmentNameValid = true;
                    $("#departmentName-status").html(`<span style="color:green;">✔ Department available</span>`);
                }
            }
        });
    });
    $("#RegisterForm").on("submit", function (e) {
        e.preventDefault();
        let form = $(this)[0];

        if (!departmentNameValid) {
            Swal.fire({
                icon: 'error',
                title: 'Department Already Exists',
                text: 'Please choose another Department.'
            });
            return;
        }


        if (!form.checkValidity()) {
            $(this).addClass('was-validated');
            return;
        }
        Swal.fire({
            title: 'Create Department?',
            text: "Are you sure you want to create?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Save',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Saving...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                $.ajax({
                    url: '/Department/Create',
                    type: 'POST',
                    data: $("#RegisterForm").serialize(),
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: function (response) {
                        Swal.close();
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: response.message,
                                showConfirmButton: false,
                                timer: 1500
                            }).then(() => {
                                window.location.href = response.redirectUrl;
                                // Reset form and Select2 elements
                            });
                        } else if (response.redirectUrl) {
                            // Redirect if controller provides URL
                            window.location.href = response.redirectUrl;
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Failed to create Department.'
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong! Please try again.'
                        });
                    }
                });
            }
        });
    });



</script>

