@using UserManagement.Data.Models
@model DepartmentModel

@{
    Layout = null;
}

<div class="modal-header">
    <h5 class="modal-title" id="userEditModalLabel">
        Edit Department: @Model.DepartmentName
    </h5>

    <button type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close">
    </button>
</div>

<form id="updateDepartmentForm"
      asp-action="LoadEditModal"
      asp-controller="Department"
      method="post"
      autocomplete="off"
      novalidate>

    <input type="hidden" asp-for="Id" />

    <div class="modal-body">

        <!-- Department Name -->
        <div class="mb-3 col-md-6">

            <label class="form-label">
                Department Name <span class="text-danger">*</span>
            </label>

            <input type="text"
                   asp-for="DepartmentName"
                   id="DepartmentName"
                   class="form-control"
                   autocomplete="off" />

            <small id="department-status"
                   class="text-danger validation-message d-none">
            </small>

        </div>

        <!-- Status -->
        <div class="mb-3 col-md-3">

            <label class="form-label">
                Status
            </label>

            <select id="Status"
                    asp-for="IsActive"
                    class="form-select">

                <option value="true">Active</option>
                <option value="false">Inactive</option>

            </select>

        </div>

    </div>

    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                class="btn btn-primary">
            Save Changes
        </button>

    </div>

</form>

<style>

    .validation-message {
        font-size: 13px;
        margin-top: 4px;
        display: block;
    }

    .select2-container {
        width: 100% !important;
    }

</style>

<!-- jQuery -->
<script src="~/assets/lib/jquery/jquery.min.js"></script>

<!-- SweetAlert -->
<script src="~/assets/js/sweetalert2.all.min.js"></script>

<!-- Select2 -->
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>

    // ============================================
    // SELECT2 INIT
    // ============================================

    $(document).ready(function () {

        var modal = $("#updateDepartmentForm").closest(".modal");

        $("#Status").select2({
            placeholder: "Select Status",
            dropdownParent: modal,
            width: '100%'
        });

    });

    // ============================================
    // VALIDATION HELPERS
    // ============================================

    function showError(messageId, message) {

        $(messageId)
            .removeClass("d-none")
            .text(message);
    }

    function clearError(messageId) {

        $(messageId)
            .addClass("d-none")
            .text("");
    }

    // ============================================
    // ORIGINAL VALUE
    // ============================================

    let originalDepartmentName = $("#DepartmentName").val().trim();

    let departmentNameValid = true;

    // ============================================
    // LIVE VALIDATION
    // ============================================

    $("#DepartmentName").on("keyup blur", function () {

        let department = $(this).val().trim();

        if (department === "") {

            showError(
                "#department-status",
                "Department Name is required."
            );

            departmentNameValid = false;

            return;
        }

        if (department.length < 2) {

            showError(
                "#department-status",
                "Minimum 2 characters required."
            );

            departmentNameValid = false;

            return;
        }

        // SAME NAME = VALID
        if (department.toLowerCase() === originalDepartmentName.toLowerCase()) {

            clearError("#department-status");

            departmentNameValid = true;

            return;
        }

        // CHECK EXISTING NAME
        $.ajax({

            url: '/Department/CheckDepartmentName',

            type: 'POST',

            data: {
                departmentName: department
            },

            success: function (res) {

                if (res.exists) {

                    showError(
                        "#department-status",
                        "Department already exists."
                    );

                    departmentNameValid = false;

                } else {

                    clearError("#department-status");

                    departmentNameValid = true;
                }
            },

            error: function () {

                showError(
                    "#department-status",
                    "Unable to validate department name."
                );

                departmentNameValid = false;
            }

        });

    });

    // ============================================
    // FORM SUBMIT
    // ============================================

    $("#updateDepartmentForm").on("submit", function (e) {

        e.preventDefault();

        let department = $("#DepartmentName").val().trim();

        let isValid = true;

        // REQUIRED
        if (department === "") {

            showError(
                "#department-status",
                "Department Name is required."
            );

            isValid = false;
        }

        // MIN LENGTH
        else if (department.length < 2) {

            showError(
                "#department-status",
                "Minimum 2 characters required."
            );

            isValid = false;
        }

        // EXIST CHECK
        else if (!departmentNameValid) {

            isValid = false;
        }

        else {

            clearError("#department-status");
        }

        // STOP
        if (!isValid) {
            return;
        }

        // ============================================
        // CONFIRM UPDATE
        // ============================================

        Swal.fire({

            title: 'Update Department?',

            icon: 'warning',

            showCancelButton: true,

            confirmButtonText: 'Yes, Update',

            cancelButtonText: 'Cancel'

        }).then((result) => {

            if (!result.isConfirmed) {
                return;
            }

            Swal.fire({

                title: 'Updating...',

                allowOutsideClick: false,

                didOpen: () => {
                    Swal.showLoading();
                }

            });

            $.ajax({

                url: '/Department/LoadEditModal',

                type: 'POST',

                data: $("#updateDepartmentForm").serialize(),

                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                },

                success: function (response) {

                    Swal.close();

                    if (response.success) {

                        Swal.fire({

                            icon: 'success',

                            title: response.message,

                            showConfirmButton: false,

                            timer: 1500

                        }).then(() => {

                            window.location.href = response.redirectUrl;

                        });

                    } else {

                        Swal.fire({

                            icon: 'error',

                            title: 'Error',

                            text: response.message || 'Failed to update department.'

                        });

                    }

                },

                error: function () {

                    Swal.fire({

                        icon: 'error',

                        title: 'Error',

                        text: 'Something went wrong! Please try again.'

                    });

                }

            });

        });

    });

</script>