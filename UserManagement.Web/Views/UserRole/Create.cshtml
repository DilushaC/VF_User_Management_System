@model UserManagement.Data.Models.UserRoleModel

@{
    ViewData["Title"] = "Create User Role";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <!-- start page title -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                </div>
            </div>
        </div>
    </div>
    <!-- Form row -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h3 class="header">@ViewData["Title"]</h3>
                    <br />
                    <form asp-action="Create" asp-controller="UserRole" method="post" id="RegisterForm" autocomplete="off" novalidate>
                        <fieldset>
                            <div class="row g-2">
                                <div class="mb-3 col-md-6 position-relative">
                                    <label asp-for="UserId" class="form-label">User Name</label>
                                    <select asp-for="UserId"
                                            class="form-control select2 round"
                                            required
                                            data-placeholder="Select User"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="right"
                                            title="Please select a user"
                                            asp-items="ViewBag.Users">
                                        <option value="">Select User</option>
                                    </select>
                                    <span asp-validation-for="UserId" class="invalid-tooltip">
                                        Please select a user
                                    </span>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="mb-3 col-md-6 position-relative">
                                    <label asp-for="RoleIds" class="form-label">User Role</label>
                                    <select asp-for="RoleIds"
                                            id="RoleIds"
                                            name="RoleIds"
                                            class="form-control select2 round"
                                            multiple="multiple"
                                            required
                                            data-placeholder=""
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="right"
                                            title="Please select at least one role"
                                            asp-items="ViewBag.Roles">
                                    </select>
                                    <span asp-validation-for="RoleIds" class="invalid-tooltip">
                                        Please select at least one role
                                    </span>
                                </div>
                            </div>


                            <button type="submit" class="btn btn-primary">Create User Role</button>
                        </fieldset>
                    </form>

                </div> <!-- end card-body -->
            </div> <!-- end card-->
        </div> <!-- end col -->
    </div>
</div>
<!-- Load jQuery only ONCE -->
<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>
<!-- Load Select2 JS -->
<script src="~/assets/vendor/select2/js/select2.min.js"></script>


<script>

    $("#UserId").select2({
        placeholder: "Select UserId",
    });

    $("#RoleIds").select2({
        width: "100%",
        allowClear: true
    });

    $("#RegisterForm").on("submit", function (e) {
        e.preventDefault();
        let form = $(this)[0];

        if (!form.checkValidity()) {
            $(this).addClass('was-validated');
            return;
        }

        Swal.fire({
            title: 'Create User Role?',
            text: "Are you sure you want to create?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Save',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Saving...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                $.ajax({
                    url: '/UserRole/Create',
                    type: 'POST',
                    data: $("#RegisterForm").serialize(),
                    headers: { "X-Requested-With": "XMLHttpRequest" },

                    success: function (response) {
                        Swal.close();

                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: response.message,
                                showConfirmButton: false,
                                timer: 1500
                            }).then(() => {
                                window.location.href = response.redirectUrl;
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Failed to create menu.'
                            });
                        }
                    },

                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong! Please try again.'
                        });
                    }
                });
            }
        });
    });



</script>

