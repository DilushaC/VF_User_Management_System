@model UserManagement.Data.Models.UserRegisterModel

@{
    ViewData["Title"] = "Register User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Theme Config Js -->
<script src="~/assets/js/config.js"></script>

<!-- App css -->
<link href="~/assets/css/app.min.css" rel="stylesheet" type="text/css" id="app-style" />

<!-- Icons css -->
<link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />

<style>
    .um-page {
        --um-primary: #0B3D91;
        --um-primary-deep: #082c6b;
        --um-active: #2D6FE0;
        --um-active-soft: rgba(45,111,224,.1);
        --um-bg: #F4F6F9;
        --um-ash: #E4E8EE;
        --um-ink: #1C2430;
        --um-muted: #64748B;
        --um-ok: #0E9F6E;
        --um-bad: #D6384A;
        --um-card: #ffffff;
    }

    .um-page {
        background: var(--um-bg);
        padding: 1.5rem 0 2.5rem;
        color: var(--um-ink);
    }

    /* ===== Header bar ===== */
    .um-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.25rem;
        padding: 1.25rem 1.5rem;
        border-radius: .75rem;
        background: linear-gradient(135deg, var(--um-primary) 0%, var(--um-primary-deep) 100%);
        color: #fff;
    }

    .um-head-title {
        display: flex;
        align-items: center;
        gap: .85rem;
    }

    .um-head-ico {
        width: 44px;
        height: 44px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        border-radius: .65rem;
        background: rgba(255,255,255,.14);
        font-size: 1.3rem;
    }

    .um-head h3 {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 700;
        color: #fff;
    }

    .um-head p {
        margin: .15rem 0 0;
        font-size: .85rem;
        color: rgba(255,255,255,.72);
    }

    .um-back-btn {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .6rem 1.1rem;
        border-radius: .6rem;
        background: rgba(255,255,255,.14);
        color: #fff;
        font-weight: 600;
        font-size: .9rem;
        text-decoration: none;
        border: none;
        transition: background .12s ease, transform .12s ease;
    }

        .um-back-btn:hover {
            background: rgba(255,255,255,.24);
            color: #fff;
            transform: translateY(-1px);
        }

    /* ===== Stat strip ===== */
    .um-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: .9rem;
        margin-bottom: 1.25rem;
    }

    .um-stat {
        background: var(--um-card);
        border: 1px solid var(--um-ash);
        border-radius: .7rem;
        padding: .9rem 1.1rem;
        display: flex;
        align-items: center;
        gap: .75rem;
    }

    .um-stat-ico {
        width: 38px;
        height: 38px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        border-radius: .55rem;
        font-size: 1.05rem;
        background: var(--um-active-soft);
        color: var(--um-active);
    }

    .um-stat-num {
        font-size: 1.1rem;
        font-weight: 700;
        line-height: 1.1;
    }

    .um-stat-label {
        font-size: .78rem;
        color: var(--um-muted);
    }

    /* ===== Form card ===== */
    .um-card {
        background: var(--um-card);
        border: 1px solid var(--um-ash);
        border-radius: .8rem;
        overflow: hidden;
    }

    .um-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--um-ash);
    }

        .um-card-head h6 {
            margin: 0;
            font-weight: 700;
            font-size: .95rem;
        }

    .um-card-body {
        padding: 1.5rem;
    }

    .um-section-title {
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: var(--um-muted);
        margin: 0 0 1rem;
        padding-bottom: .5rem;
        border-bottom: 1px dashed var(--um-ash);
    }

    .um-section + .um-section {
        margin-top: 1.75rem;
    }

    .um-page .form-label {
        font-weight: 600;
        font-size: .85rem;
        color: var(--um-ink);
    }

    .um-page .form-control,
    .um-page .select2-container .select2-selection--multiple,
    .um-page .select2-container .select2-selection--single {
        border: 1px solid var(--um-ash);
        border-radius: .55rem !important;
    }

        .um-page .form-control:focus {
            outline: none;
            border-color: var(--um-active);
            box-shadow: 0 0 0 3px var(--um-active-soft);
        }

    .um-page .select2-container--default.select2-container--focus .select2-selection--multiple,
    .um-page .select2-container--default .select2-selection--single:focus {
        border-color: var(--um-active) !important;
        box-shadow: 0 0 0 3px var(--um-active-soft);
    }

    .um-page .select2-selection__choice {
        background: var(--um-active-soft) !important;
        color: var(--um-primary) !important;
        border: none !important;
        border-radius: .4rem !important;
    }

    .um-hint {
        font-size: .76rem;
        color: var(--um-muted);
        display: block;
        margin-top: .15rem;
    }

    .um-status {
        display: block;
        margin-top: .35rem;
        font-size: .8rem;
    }

    .um-card-footer {
        display: flex;
        justify-content: flex-end;
        gap: .75rem;
        padding: 1.1rem 1.5rem;
        border-top: 1px solid var(--um-ash);
        background: var(--um-bg);
    }

    .um-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .65rem 1.4rem;
        border-radius: .6rem;
        background: var(--um-active);
        border: none;
        color: #fff;
        font-weight: 700;
        font-size: .9rem;
        transition: background .12s ease, transform .12s ease;
    }

        .um-btn-primary:hover {
            background: var(--um-primary);
            transform: translateY(-1px);
        }

    .um-btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .65rem 1.3rem;
        border-radius: .6rem;
        background: #fff;
        border: 1px solid var(--um-ash);
        color: var(--um-muted);
        font-weight: 600;
        font-size: .9rem;
        text-decoration: none;
    }

        .um-btn-ghost:hover {
            color: var(--um-ink);
            border-color: var(--um-muted);
        }
</style>

<div class="um-page">
    <div class="container-fluid">

        <div class="um-head">
            <div class="um-head-title">
                <span class="um-head-ico"><i class="ri-user-add-line"></i></span>
                <div>
                    <h3>@ViewData["Title"]</h3>
                    <p>Create a new account and assign branch, department and product access</p>
                </div>
            </div>
            <a href="@Url.Action("Management", "User")" class="um-back-btn">
                <i class="ri-arrow-left-line"></i> Back to users
            </a>
        </div>

        <form asp-action="RegisterUser" asp-controller="User" method="post" id="RegisterForm" autocomplete="off" novalidate>
            <fieldset>
                <div class="um-card">
                    <div class="um-card-head">
                        <h6><i class="ri-user-settings-line me-1" style="color:var(--um-active);"></i>User details</h6>
                    </div>
                    <div class="um-card-body">

                        <!-- Account -->
                        <div class="um-section">
                            <p class="um-section-title">Account</p>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="UserName" class="form-label">User Name</label>
                                    <input asp-for="UserName" class="form-control" id="UserName" required autocomplete="off" />
                                    <small id="username-status" class="um-status"></small>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="FirstName" class="form-label">First Name</label>
                                    <input asp-for="FirstName" class="form-control" id="FirstName" required />
                                    <small id="firstname-status" class="um-status"></small>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="LastName" class="form-label">Last Name</label>
                                    <input asp-for="LastName" class="form-control" id="LastName" required />
                                    <small id="lastname-status" class="um-status"></small>
                                </div>
                            </div>
                            <div class="row g-3 mt-0">
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label">Email</label>
                                    <input asp-for="Email" type="email" class="form-control" id="Email" required />
                                    <small id="email-status" class="um-status"></small>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Phone" class="form-label">Phone</label>
                                    <input asp-for="Phone"
                                           id="Phone"
                                           type="tel"
                                           class="form-control"
                                           required
                                           autocomplete="off"
                                           maxlength="10"
                                           placeholder="07XXXXXXXX" />
                                    <small id="phone-status" class="um-status"></small>
                                </div>
                            </div>
                        </div>

                        <!-- Access -->
                        <div class="um-section">
                            <p class="um-section-title">Access</p>
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label asp-for="ProductIds" class="form-label">
                                        Products
                                        <span class="um-hint">Select one or more products for user access</span>
                                    </label>
                                    <select asp-for="ProductIds"
                                            id="ProductIds"
                                            name="ProductIds"
                                            class="form-control select2"
                                            multiple="multiple"
                                            required
                                            data-placeholder=""
                                            asp-items="ViewBag.Products">
                                    </select>
                                    <small id="products-status" class="um-status"></small>
                                </div>
                            </div>
                        </div>

                        <!-- Org placement -->
                        <div class="um-section">
                            <p class="um-section-title">Org placement</p>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="DesignationId" class="form-label">Designation Name</label>
                                    <select asp-for="DesignationId"
                                            id="DesignationId"
                                            class="form-control select2"
                                            required
                                            asp-items="ViewBag.Designations">
                                        <option value="">Select Designation</option>
                                    </select>
                                    <small id="designation-status" class="um-status"></small>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="PrimaryBranchId" class="form-label">Branch Name</label>
                                    <select asp-for="PrimaryBranchId"
                                            id="PrimaryBranchId"
                                            class="form-control select2"
                                            required
                                            asp-items="ViewBag.Branches">
                                        <option value="">Select Branch</option>
                                    </select>
                                    <small id="branch-status" class="um-status"></small>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="PrimaryDepartmentId" class="form-label">Primary Department</label>
                                    <select asp-for="PrimaryDepartmentId"
                                            id="PrimaryDepartmentId"
                                            class="form-control select2"
                                            required
                                            asp-items="ViewBag.Departments">
                                        <option value="">Select Department</option>
                                    </select>
                                    <small id="department-status" class="um-status"></small>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="um-card-footer">
                        <a href="@Url.Action("Index", "User")" class="um-btn-ghost">Cancel</a>
                        <button type="submit" class="um-btn-primary"><i class="ri-save-line"></i> Create User</button>
                    </div>
                </div>
            </fieldset>
        </form>

    </div>
</div>

<!-- Scripts -->
<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>

    // ── Helpers ──────────────────────────────────────────────────────────────
    function setMsg(id, text, isError) {
        $("#" + id).html(text
            ? '<span style="color:' + (isError ? 'var(--um-bad)' : 'var(--um-ok)') + ';">' +
              (isError ? '❌ ' : '✔ ') + text + '</span>'
            : '');
    }

    function clearMsg(id) { $("#" + id).html(''); }

    // ── Select2 Init ─────────────────────────────────────────────────────────
    $("#PrimaryBranchId").select2({ placeholder: "Select Branch" });
    $("#PrimaryDepartmentId").select2({ placeholder: "Select Department" });
    $("#DesignationId").select2({ placeholder: "Select Designation" });
    $("#ProductIds").select2({ placeholder: "" });

    // ── Tracking flags ───────────────────────────────────────────────────────
    let usernameValid = false;
    let emailValid    = false;
    let phoneValid    = false;

    // ── Username ─────────────────────────────────────────────────────────────
    $("#UserName").on('blur', function () {
        let username = $(this).val().trim();

        if (username.length === 0) {
            setMsg('username-status', 'User Name is required.', true);
            usernameValid = false;
            return;
        }

        if (username.length < 3) {
            setMsg('username-status', 'Minimum 3 characters required.', true);
            usernameValid = false;
            return;
        }

        $.ajax({
            url: '/User/CheckUsername',
            type: 'POST',
            data: { username: username },
            success: function (res) {
                if (res.exists) {
                    usernameValid = false;
                    setMsg('username-status', 'Username already exists.', true);
                } else {
                    usernameValid = true;
                    setMsg('username-status', 'Username available.', false);
                }
            }
        });
    });

    // ── First Name ───────────────────────────────────────────────────────────
    $("#FirstName").on('blur', function () {
        if ($(this).val().trim() === '') {
            setMsg('firstname-status', 'First Name is required.', true);
        } else {
            clearMsg('firstname-status');
        }
    });

    // ── Last Name ────────────────────────────────────────────────────────────
    $("#LastName").on('blur', function () {
        if ($(this).val().trim() === '') {
            setMsg('lastname-status', 'Last Name is required.', true);
        } else {
            clearMsg('lastname-status');
        }
    });

    // ── Email ────────────────────────────────────────────────────────────────
    $("#Email").on("keyup blur", function () {
        let email = $(this).val().trim();

        if (email.length === 0) {
            setMsg('email-status', 'Email is required.', true);
            emailValid = false;
            return;
        }

        // Basic email format check
        let emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        if (!emailRegex.test(email)) {
            emailValid = false;
            setMsg('email-status', 'Please enter a valid email address.', true);
        } else {
            emailValid = true;
            setMsg('email-status', 'Email looks valid.', false);
        }
    });

    // ── Phone ────────────────────────────────────────────────────────────────
    $("#Phone").on("keyup blur", function () {
        let phone = $(this).val().trim();

        if (phone.length === 0) {
            setMsg('phone-status', 'Phone number is required.', true);
            phoneValid = false;
            return;
        }

        phone = phone.replace(/\s+/g, '');
        let slRegex = /^(?:\+94|94|0)7\d{8}$/;

        if (!slRegex.test(phone)) {
            phoneValid = false;
            setMsg('phone-status', 'Enter a valid Sri Lankan mobile number (e.g. 07XXXXXXXX).', true);
        } else {
            phoneValid = true;
            setMsg('phone-status', 'Valid Sri Lankan phone number.', false);
        }
    });

    // ── Select dropdowns / multi-select ──────────────────────────────────────
    function validateSelect(selectId, statusId, message) {
        let val = $("#" + selectId).val();
        let empty = !val || (Array.isArray(val) ? val.length === 0 : val === '');
        if (empty) {
            setMsg(statusId, message, true);
            return false;
        } else {
            clearMsg(statusId);
            return true;
        }
    }

    $("#ProductIds").on('change', function () {
        validateSelect('ProductIds', 'products-status', 'Please select at least one product.');
    });

    $("#DesignationId").on('change', function () {
        validateSelect('DesignationId', 'designation-status', 'Please select a designation.');
    });

    $("#PrimaryBranchId").on('change', function () {
        validateSelect('PrimaryBranchId', 'branch-status', 'Please select a branch.');
    });

    $("#PrimaryDepartmentId").on('change', function () {
        validateSelect('PrimaryDepartmentId', 'department-status', 'Please select a department.');
    });

    // ── Form Submit ───────────────────────────────────────────────────────────
    $("#RegisterForm").on("submit", function (e) {
        e.preventDefault();

        let isValid = true;

        // Trigger all blur/change validations on submit
        if ($("#UserName").val().trim() === '') {
            setMsg('username-status', 'User Name is required.', true);
            usernameValid = false;
        }
        if (!usernameValid)    isValid = false;

        if ($("#FirstName").val().trim() === '') {
            setMsg('firstname-status', 'First Name is required.', true);
            isValid = false;
        }

        if ($("#LastName").val().trim() === '') {
            setMsg('lastname-status', 'Last Name is required.', true);
            isValid = false;
        }

        if (!emailValid) {
            if ($("#Email").val().trim() === '') {
                setMsg('email-status', 'Email is required.', true);
            }
            isValid = false;
        }

        if (!phoneValid) {
            if ($("#Phone").val().trim() === '') {
                setMsg('phone-status', 'Phone number is required.', true);
            }
            isValid = false;
        }

        if (!validateSelect('ProductIds',          'products-status',    'Please select at least one product.'))  isValid = false;
        if (!validateSelect('DesignationId',        'designation-status', 'Please select a designation.'))         isValid = false;
        if (!validateSelect('PrimaryBranchId',      'branch-status',      'Please select a branch.'))              isValid = false;
        if (!validateSelect('PrimaryDepartmentId',  'department-status',  'Please select a department.'))          isValid = false;

        if (!isValid) return;

        // Confirm then submit
        Swal.fire({
            title: 'Create User?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Save',
            cancelButtonText: 'Cancel'
        }).then((result) => {

            if (!result.isConfirmed) return;

            Swal.fire({
                title: 'Saving...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            $.ajax({
                url: '/User/Register',
                type: 'POST',
                data: $("#RegisterForm").serialize(),
                headers: { "X-Requested-With": "XMLHttpRequest" },

                success: function (response) {
                    Swal.close();

                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: response.message,
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            window.location.href = response.redirectUrl;
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message || 'Failed to create user.'
                        });
                    }
                },

                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Something went wrong! Please try again.'
                    });
                }
            });
        });
    });

</script>
