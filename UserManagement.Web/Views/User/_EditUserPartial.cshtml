@using UserManagement.Data.Models
@model UserModel
@{
    Layout = null;
}

<style>
    .um-edit {
        --um-primary: #0B3D91;
        --um-active: #2D6FE0;
        --um-active-soft: rgba(45,111,224,.1);
        --um-ash: #E4E8EE;
        --um-bg: #F4F6F9;
        --um-ink: #1C2430;
        --um-muted: #64748B;
        --um-ok: #0E9F6E;
        --um-bad: #D6384A;
    }

        .um-edit .modal-header {
            align-items: center;
            gap: .85rem;
            padding: 1.1rem 1.4rem;
            background: linear-gradient(135deg, var(--um-primary) 0%, #082c6b 100%);
            border-bottom: none;
        }

            .um-edit .modal-header .um-edit-ico {
                width: 40px;
                height: 40px;
                flex: 0 0 auto;
                display: grid;
                place-items: center;
                border-radius: .6rem;
                background: rgba(255,255,255,.14);
                color: #fff;
                font-size: 1.1rem;
            }

        .um-edit .modal-title {
            color: #fff;
            font-weight: 700;
            font-size: 1.05rem;
            margin: 0;
        }

            .um-edit .modal-title small {
                display: block;
                font-weight: 500;
                font-size: .78rem;
                color: rgba(255,255,255,.68);
                margin-top: .1rem;
            }

        .um-edit .btn-close {
            filter: invert(1) grayscale(100%) brightness(200%);
            opacity: .85;
        }

            .um-edit .btn-close:hover {
                opacity: 1;
            }

        .um-edit .modal-body {
            background: var(--um-bg);
            padding: 1.4rem 1.4rem .6rem;
        }

    .um-edit-section {
        background: #fff;
        border: 1px solid var(--um-ash);
        border-radius: .7rem;
        padding: 1.1rem 1.2rem;
        margin-bottom: 1rem;
    }

    .um-edit-section-title {
        font-size: .76rem;
        font-weight: 700;
        color: var(--um-muted);
        margin-bottom: .9rem;
        display: flex;
        align-items: center;
        gap: .4rem;
    }

        .um-edit-section-title i {
            color: var(--um-active);
            font-size: .95rem;
        }

    .um-edit .form-label {
        font-weight: 600;
        font-size: .85rem;
        color: var(--um-ink);
        margin-bottom: .35rem;
    }

    .um-edit .form-control,
    .um-edit .form-select,
    .um-edit .select2-container--default .select2-selection--multiple,
    .um-edit .select2-container--default .select2-selection--single {
        border: 1.5px solid var(--um-ash) !important;
        border-radius: .55rem !important;
        background: #fff;
    }

        .um-edit .form-control:focus,
        .um-edit .form-select:focus {
            border-color: var(--um-active) !important;
            box-shadow: 0 0 0 3px var(--um-active-soft) !important;
        }

        .um-edit .select2-container--default.select2-container--focus .select2-selection--multiple,
        .um-edit .select2-container--default .select2-selection--single:focus {
            border-color: var(--um-active) !important;
            box-shadow: 0 0 0 3px var(--um-active-soft) !important;
        }

    .um-edit .select2-selection__choice {
        background: var(--um-active-soft) !important;
        border: 1px solid var(--um-active) !important;
        color: var(--um-primary) !important;
        border-radius: .4rem !important;
    }

    .um-edit .form-text {
        font-size: .78rem;
        font-weight: 600;
        min-height: 1.1em;
        display: block;
        margin-top: .3rem;
    }

        .um-edit .form-text .status-ok {
            color: var(--um-ok);
        }

        .um-edit .form-text .status-bad {
            color: var(--um-bad);
        }

    .um-edit .text-danger {
        color: var(--um-bad) !important;
    }

    .um-edit .modal-footer {
        background: var(--um-bg);
        border-top: 1px solid var(--um-ash);
        padding: 1rem 1.4rem;
        gap: .6rem;
    }

    .um-edit .btn-secondary {
        background: #fff;
        border: 1.5px solid var(--um-ash);
        color: var(--um-muted);
        font-weight: 600;
        border-radius: .55rem;
        padding: .55rem 1.2rem;
    }

        .um-edit .btn-secondary:hover {
            background: var(--um-bg);
            border-color: var(--um-muted);
            color: var(--um-ink);
        }

    .um-edit .btn-primary {
        background: var(--um-active);
        border: none;
        font-weight: 700;
        border-radius: .55rem;
        padding: .55rem 1.3rem;
        box-shadow: 0 6px 16px -7px rgba(45,111,224,.6);
    }

        .um-edit .btn-primary:hover {
            background: var(--um-primary);
            transform: translateY(-1px);
        }

    /* Status select color-codes without extra markup */
    .um-edit #IsActive {
        font-weight: 600;
    }

    /* Select2 dropdowns are repositioned via JS (select2:open) to sit directly
           under their field; this keeps them above the modal's other content and
           stops Bootstrap/Select2's own position:absolute from stacking them oddly. */
    .select2-container--open .select2-dropdown {
        position: fixed !important;
        z-index: 2000 !important;
    }
</style>

<div class="um-edit">

    <div class="modal-header">
        <span class="um-edit-ico"><i class="ri-user-settings-line"></i></span>
        <h5 class="modal-title" id="userEditModalLabel">
            Edit user
            <small>@Model.UserName</small>
        </h5>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <form id="updateUserForm" asp-action="UpdateUser" asp-controller="Users" method="post" autocomplete="off" novalidate>
        <input type="hidden" asp-for="Id" />

        <div class="modal-body">

            <!-- Account -->
            <div class="um-edit-section">
                <div class="um-edit-section-title"><i class="ri-shield-user-line"></i>Account</div>

                <div class="mb-3 col-md-6">
                    <label class="form-label">Username</label>
                    <input type="text" asp-for="UserName" id="UserName" class="form-control" autocomplete="off" />
                    <small id="username-status" class="form-text"></small>
                </div>

                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label class="form-label">First name <span class="text-danger">*</span></label>
                        <input type="text" asp-for="FirstName" id="FirstName" class="form-control" required />
                        <small id="firstName-status" class="form-text"></small>
                    </div>
                    <div class="mb-3 col-md-6">
                        <label class="form-label">Last name</label>
                        <input type="text" asp-for="LastName" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label class="form-label">Email address <span class="text-danger">*</span></label>
                        <input type="email" asp-for="Email" id="Email" class="form-control" required />
                        <small id="email-status" class="form-text"></small>
                    </div>
                    <div class="mb-0 col-md-6">
                        <label class="form-label">Phone number</label>
                        <input type="text" asp-for="Phone" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- Access -->
            <div class="um-edit-section">
                <div class="um-edit-section-title"><i class="ri-apps-2-line"></i>Access</div>

                <div class="mb-0">
                    <label asp-for="ProductIds" class="form-label">Products <span class="text-danger">*</span></label>
                    <select asp-for="ProductIds"
                            id="ProductIds"
                            name="ProductIds"
                            class="form-control select2 round"
                            multiple="multiple"
                            required
                            data-placeholder="Select Products"
                            asp-items="ViewBag.Products">
                    </select>
                    <small id="products-status" class="form-text"></small>
                </div>
            </div>

            <!-- Organization -->
            <div class="um-edit-section">
                <div class="um-edit-section-title"><i class="ri-building-2-line"></i>Organization</div>

                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label class="form-label">Designation</label>
                        <select id="DesignationId" asp-for="DesignationId" class="form-select" asp-items="ViewBag.Designations">
                        </select>
                    </div>
                    <div class="mb-3 col-md-6">
                        <label class="form-label">Status</label>
                        <select id="IsActive" asp-for="IsActive" class="form-select">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="mb-0 col-md-6">
                        <label class="form-label">Primary branch</label>
                        <select id="PrimaryBranchId" asp-for="PrimaryBranchId" class="form-select" asp-items="ViewBag.Branches">
                        </select>
                    </div>
                    <div class="mb-0 col-md-6">
                        <label class="form-label">Primary department</label>
                        <select id="PrimaryDepartmentId" asp-for="PrimaryDepartmentId" class="form-select" asp-items="ViewBag.Departments">
                        </select>
                    </div>
                </div>
            </div>

        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary"><i class="ri-save-3-line me-1"></i>Save changes</button>
        </div>
    </form>
</div>

<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>

    // ── Helper ────────────────────────────────────────────────────────────────
    function setMsg(id, text, isError) {
        $("#" + id).html(text
            ? '<span class="' + (isError ? 'status-bad' : 'status-ok') + '">' +
              (isError ? '\u274C ' : '\u2714 ') + text + '</span>'
            : '');
    }

    function isValidEmail(val) {
        var re = new RegExp('^[^\\s\\x40]+\\x40[^\\s\\x40]+\\.[^\\s\\x40]+$');
        return re.test(val);
    }

    // ── Select2 Init ─────────────────────────────────────────────────────────
    // dropdownParent fixes dropdown clipping/z-index inside Bootstrap modals.
    // Anchor to the modal DIALOG (not document.body) so dropdowns render
    // directly under their field instead of floating at the page's own scroll position.
    var $modal = $("#userEditModal");
    if ($modal.length === 0) {
        $modal = $("#updateUserForm").closest(".modal");
    }
    if ($modal.length === 0) {
        $modal = $(document.body);
    }

    $("#DesignationId").select2({    placeholder: "Select Designation", dropdownParent: $modal });
    $("#PrimaryBranchId").select2({  placeholder: "Select Branch",      dropdownParent: $modal });
    $("#PrimaryDepartmentId").select2({ placeholder: "Select Department", dropdownParent: $modal });
    $("#IsActive").select2({         placeholder: "Select Status",       dropdownParent: $modal });
    $("#ProductIds").select2({       placeholder: "Select Products",     dropdownParent: $modal });

    // Select2's "flip upward when short on space below" behavior misfires inside
    // scrollable modals (it measures against the wrong container and jumps to the
    // top of the modal instead of just below the field). Force every dropdown
    // opened from this form to always render below its field, and reposition it
    // to sit directly under the field it belongs to.
    $modal.on('select2:open', function (e) {
        var fieldId = $(e.target).attr('id');
        var $select2Container = $('#select2-' + fieldId + '-container').closest('.select2');

        setTimeout(function () {
            var $dropdown = $('.select2-container--open .select2-dropdown');
            if ($dropdown.length === 0 || $select2Container.length === 0) { return; }

            $dropdown.removeClass('select2-dropdown--above').addClass('select2-dropdown--below');

            // Dropdown is position:fixed (see CSS), so use getBoundingClientRect
            // (viewport-relative) rather than .offset() (document-relative) —
            // using offset() here was the earlier bug that put it in the wrong spot.
            var rect = $select2Container[0].getBoundingClientRect();

            $dropdown.css({
                top: rect.bottom + 'px',
                left: rect.left + 'px',
                width: rect.width + 'px'
            });
        }, 0);
    });

    // ── Validation flags ──────────────────────────────────────────────────────
    var usernameValid  = true;   // assume valid until user edits it
    var firstNameValid = false;
    var emailValid     = false;
    var productsValid  = false;

    // Capture originals — skip duplicate-check when value is unchanged
    var originalUsername = $("#UserName").val().trim();
    var originalEmail    = $("#Email").val().trim();

    // ── Pre-validate on modal open ────────────────────────────────────────────
    (function preValidate() {
        if ($("#FirstName").val().trim().length >= 2) {
            firstNameValid = true;
        }
        var emailVal = $("#Email").val().trim();
        if (emailVal.length > 0) {
            emailValid = true;   // existing saved email is always considered valid
        }
        if ($("#ProductIds").val() && $("#ProductIds").val().length > 0) {
            productsValid = true;
        }
    })();

    // ── Username blur check ───────────────────────────────────────────────────
    $("#UserName").on('blur', function () {
        var username = $(this).val().trim();

        if (username.length === 0) {
            setMsg('username-status', 'Username is required.', true);
            usernameValid = false;
            return;
        }
        if (username.length < 3) {
            setMsg('username-status', 'Minimum 3 characters required.', true);
            usernameValid = false;
            return;
        }
        // Unchanged — no need to check
        if (username === originalUsername) {
            setMsg('username-status', '', false);
            usernameValid = true;
            return;
        }

        $.ajax({
            url: '/User/CheckUserName',
            type: 'POST',
            data: { userName: username },
            success: function (res) {
                if (res.exists) {
                    usernameValid = false;
                    setMsg('username-status', 'Username already taken.', true);
                } else {
                    usernameValid = true;
                    setMsg('username-status', 'Username available.', false);
                }
            },
            error: function () {
                usernameValid = false;
                setMsg('username-status', 'Could not verify username.', true);
            }
        });
    });

    // ── First Name blur check ─────────────────────────────────────────────────
    $("#FirstName").on('blur', function () {
        var val = $(this).val().trim();
        if (val.length === 0) {
            setMsg('firstName-status', 'First Name is required.', true);
            firstNameValid = false;
        } else if (val.length < 2) {
            setMsg('firstName-status', 'Minimum 2 characters required.', true);
            firstNameValid = false;
        } else {
            setMsg('firstName-status', 'Looks good.', false);
            firstNameValid = true;
        }
    });

    // ── Email blur check ──────────────────────────────────────────────────────
    $("#Email").on('blur', function () {
        var val = $(this).val().trim();

        if (val.length === 0) {
            setMsg('email-status', 'Email Address is required.', true);
            emailValid = false;
        } else if (val === originalEmail) {
            // User kept the original email — always valid, clear any error
            setMsg('email-status', '', false);
            emailValid = true;
        } else if (!isValidEmail(val)) {
            setMsg('email-status', 'Enter a valid email address.', true);
            emailValid = false;
        } else {
            setMsg('email-status', 'Valid email.', false);
            emailValid = true;
        }
    });

    // ── Products change check ─────────────────────────────────────────────────
    $("#ProductIds").on('change', function () {
        var selected = $(this).val();
        if (!selected || selected.length === 0) {
            setMsg('products-status', 'Please select at least one product.', true);
            productsValid = false;
        } else {
            setMsg('products-status', 'Product(s) selected.', false);
            productsValid = true;
        }
    });

    // ── Form Submit ───────────────────────────────────────────────────────────
    $("#updateUserForm").on("submit", function (e) {
        e.preventDefault();
        var $form = $(this);   // cache — $(this) breaks inside .then()

        // Re-check First Name
        if ($("#FirstName").val().trim() === '') {
            setMsg('firstName-status', 'First Name is required.', true);
            firstNameValid = false;
        }

        // Re-check Email
        var emailVal = $("#Email").val().trim();
        if (emailVal === '') {
            setMsg('email-status', 'Email Address is required.', true);
            emailValid = false;
        } else if (emailVal !== originalEmail && !isValidEmail(emailVal)) {
            setMsg('email-status', 'Enter a valid email address.', true);
            emailValid = false;
        }

        // Re-check Products
        if (!$("#ProductIds").val() || $("#ProductIds").val().length === 0) {
            setMsg('products-status', 'Please select at least one product.', true);
            productsValid = false;
        }

        if (!usernameValid || !firstNameValid || !emailValid || !productsValid) {
            Swal.fire({
                icon: 'warning',
                title: 'Missing Information',
                text: 'Please fix the highlighted fields before saving.'
            });
            return;
        }

        Swal.fire({
            title: 'Update User?',
            text: 'Are you sure you want to save changes?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Update',
            cancelButtonText: 'Cancel'
        }).then(function (result) {

            if (!result.isConfirmed) return;

            Swal.fire({
                title: 'Updating...',
                allowOutsideClick: false,
                didOpen: function () { Swal.showLoading(); }
            });

            $.ajax({
                url: '/User/LoadEditModal',
                type: 'POST',
                data: $form.serialize(),
                headers: { "X-Requested-With": "XMLHttpRequest" },

                success: function (response) {
                    Swal.close();
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: response.message,
                            showConfirmButton: false,
                            timer: 1500
                        }).then(function () {
                            window.location.href = response.redirectUrl;
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message || 'Failed to update user.'
                        });
                    }
                },

                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Something went wrong! Please try again.'
                    });
                }
            });
        });
    });

</script>
