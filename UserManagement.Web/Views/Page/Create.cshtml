@model UserManagement.Data.Models.PageModel

@{
    ViewData["Title"] = "Create Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="row p-2">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h3 class="header">@ViewData["Title"]</h3>
                    <br />
                    <form asp-action="Create" asp-controller="Page" method="post" id="RegisterForm" novalidate>
                        <fieldset @(ViewBag.CanEdit != null && !(bool)ViewBag.CanEdit ? "disabled" : "")>
                            <div class="row g-2">
                                <div class="mb-3 col-md-6 position-relative">
                                    <label asp-for="PageName" class="form-label">Page Name</label>
                                    <input asp-for="PageName" class="form-control round" required
                                           data-bs-toggle="tooltip" data-bs-placement="right" title="Page Name is required" />
                                    <span asp-validation-for="PageName" class="invalid-tooltip">Page Name is required</span>
                                    <small id="pageName-status"></small>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="mb-3 col-md-6 position-relative">
                                    <label asp-for="ProductId" class="form-label">Select Product</label>
                                    <select id="ProductId"
                                            asp-for="ProductId"
                                            class="form-control select2 round"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="right"
                                            title="Product is required"
                                            required
                                            data-placeholder="Select Base Product"
                                            asp-items="ViewBag.Products">
                                        <option value="">Select Product</option>
                                    </select>
                                    <span asp-validation-for="ProductId" class="invalid-tooltip">Product is required</span>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="mb-3 col-md-6 position-relative">
                                    <label asp-for="PageUrl" class="form-label">Page URL</label>
                                    <input asp-for="PageUrl" class="form-control round" required
                                           data-bs-toggle="tooltip" data-bs-placement="right" title="Page URL is required" />
                                    <span asp-validation-for="PageUrl" class="invalid-tooltip">Page URL is required</span>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="mb-3 col-md-2 position-relative">
                                    <label asp-for="PageCode" class="form-label">Page Code</label>
                                    <input asp-for="PageCode" class="form-control round" required
                                           data-bs-toggle="tooltip" data-bs-placement="right" title="Page Code is required" />
                                    <span asp-validation-for="PageCode" class="invalid-tooltip">Page Code is required</span>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="mb-3 col-md-1 position-relative">
                                    <label asp-for="PageLevel" class="form-label">Page Level</label>
                                    <input asp-for="PageLevel" type="number" class="form-control round" required min="1"
                                           data-bs-toggle="tooltip" data-bs-placement="right" title="Product Selection is required" disabled />
                                    <span asp-validation-for="PageLevel" class="invalid-tooltip">Page Level is required</span>
                                    <small id="pageLevel-status"></small>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="mb-3 col-md-6 position-relative">
                                    <label asp-for="Description" class="form-label">Description</label>
                                    <textarea asp-for="Description" class="form-control round" required
                                              data-bs-toggle="tooltip" data-bs-placement="right" title="Description is required"></textarea>
                                    <span asp-validation-for="Description" class="invalid-tooltip">Description is required</span>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="mb-3 col-md-2">
                                    <label asp-for="IsActive" class="form-label">Active Status</label>
                                    <select asp-for="IsActive" class="form-select">
                                        <option value="true">Active</option>
                                        <option value="false">Inactive</option>
                                    </select>
                                    <span asp-validation-for="IsActive" class="text-danger"></span>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">Create Page</button>
                        </fieldset>
                    </form>
                </div> <!-- end card-body -->
            </div> <!-- end card-->
        </div> <!-- end col -->
    </div>
</div>
<!-- Load jQuery only ONCE -->
<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>
<!-- Load Select2 JS -->
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>
    $("#ProductId").select2({
        placeholder: "Select Product",
    });

    $("#ProductId").on('change', function () {
        var productId = $(this).val();
        if (productId) {
            $("#PageLevel").prop('disabled', false);
            $("#PageLevel").val('');
        } else {
            $("#PageLevel").prop('disabled', true);   // Keep disabled if no product selected
            $("#PageLevel").val('');                   // Optional: clear value
            $("#pageLevel-status").html('');           // Optional: clear validation message
        }
    });


    let pageNameValid = false;
    let pageLevelValid = false;

    $("#PageName").on('blur', function () {
    let pageName = $(this).val().trim();

        if (pageName.length < 3) {
            $("#pageName-status").html(`<span style="color:gray;">Minimum 3 characters required</span>`);
            pageNameValid = false;
            return;
        }

        $.ajax({
            url: '/Page/CheckPageName',
            type: 'POST',
            data: { pageName: pageName },
            success: function (res) {
                if (res.exists) {
                    pageNameValid = false;
                    $("#pageName-status").html(`<span style="color:red;">❌ Page already exists</span>`);
                } else {
                    pageNameValid = true;
                    $("#pageName-status").html(`<span style="color:green;">✔ Page available</span>`);
                }
            }
        });
    });

    $("#PageLevel").on('blur', function () {
    let pageLevel = $(this).val().trim();
    var productId = $("#ProductId").val();
        $.ajax({
            url: '/Page/CheckPageLevel',
            type: 'POST',
            data: { pageLevel: pageLevel,productId: productId },
            success: function (res) {
                if (res.exists) {
                    pageLevelValid = false;
                    $("#pageLevel-status").html(`<span style="color:red;">❌ Page Level exists</span>`);
                } else {
                    pageLevelValid = true;
                    $("#pageLevel-status").html(`<span style="color:green;">✔ Page Level available</span>`);
                }
            }
        });
    });

    $("#RegisterForm").on("submit", function (e) {
        e.preventDefault();
        let form = $(this)[0];

        if (!pageNameValid) {
            Swal.fire({
                icon: 'error',
                title: 'Page Already Exists',
                text: 'Please Create another Page.'
            });
            return;
        }

        if (!pageLevelValid) {
            Swal.fire({
                icon: 'error',
                title: 'Page Level Already Exists',
                text: 'Please choose another Page Level.'
            });
            return;
        }

        if (!form.checkValidity()) {
            $(this).addClass('was-validated');
            return;
        }
        Swal.fire({
            title: 'Create Page?',
            text: "Are you sure you want to create?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Save',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Saving...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                $.ajax({
                    url: '/Page/Create',
                    type: 'POST',
                    data: $("#RegisterForm").serialize(),
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: function (response) {
                        Swal.close();
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: response.message,
                                showConfirmButton: false,
                                timer: 1500
                            }).then(() => {
                                window.location.href = response.redirectUrl;
                                // Reset form and Select2 elements
                            });
                        } else if (response.redirectUrl) {
                            // Redirect if controller provides URL
                            window.location.href = response.redirectUrl;
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Failed to create page.'
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong! Please try again.'
                        });
                    }
                });
            }
        });
    });



</script>

