@using UserManagement.Data.Models
@model PageModel
@{
    Layout = null;
}

<div class="modal-header">
    <h5 class="modal-title" id="userEditModalLabel">Edit Page: @Model.PageName</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="updatePageForm" asp-action="LoadEditModal" asp-controller="Page" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="modal-body">

        <div class="mb-3 col-md-6">
            <label class="form-label">Page Name</label>
            <input type="text" asp-for="PageName" class="form-control" readonly />
        </div>
        <div class="mb-3 col-md-6">
            <label class="form-label">Page Url</label>
            <input type="text" asp-for="PageUrl" class="form-control" />
        </div>
        <div class="mb-3 col-md-6">
            <label class="form-label">Product</label>
            <select id="ProductId" asp-for="ProductId" class="form-control select2" asp-items="ViewBag.Products">
            </select>
        </div>
        <div class="mb-3 col-md-6">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="mb-3  col-md-3">
            <label class="form-label">Status</label>
            <select id="Status" asp-for="IsActive" class="form-control select2">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
</form>

<!-- Load jQuery only ONCE -->
<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>
<!-- Load Select2 JS -->
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>
    $("#ProductId").select2({
        placeholder: "Select Product",
    });

    $("#Status").select2({
        placeholder: "Select Status",
    });

    $("#updatePageForm").on("submit", function (e) {
        debugger;
        e.preventDefault();
        let form = $(this);

        if (!form[0].checkValidity()) {
            Swal.fire({
                icon: "warning",
                title: "Missing Information",
                text: "Please fill in all required fields."
            });
            return;
        }
        Swal.fire({
            title: 'Update Page?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Update',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Updating...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                $.ajax({
                    url: '/Page/LoadEditModal',
                    type: 'POST',
                    data: form.serialize(),
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: function (response) {
                        Swal.close();

                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: response.message,
                                showConfirmButton: false,
                                timer: 1500
                            }).then(() => {
                                window.location.href = response.redirectUrl;
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Failed to create menu.'
                            });
                        }
                    },

                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong! Please try again.'
                        });
                    }
                });
            }
        });
    });
</script>


