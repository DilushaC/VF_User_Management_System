@using UserManagement.Data.Models
@{
    ViewData["Title"] = "Pages Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Datatables css -->
<link href="~/assets/vendor/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet" type="text/css" />
<link href="~/assets/vendor/datatables.net-responsive-bs5/css/responsive.bootstrap5.min.css" rel="stylesheet" type="text/css" />
<link href="~/assets/vendor/datatables.net-fixedcolumns-bs5/css/fixedColumns.bootstrap5.min.css" rel="stylesheet" type="text/css" />
<link href="~/assets/vendor/datatables.net-fixedheader-bs5/css/fixedHeader.bootstrap5.min.css" rel="stylesheet" type="text/css" />
<link href="~/assets/vendor/datatables.net-buttons-bs5/css/buttons.bootstrap5.min.css" rel="stylesheet" type="text/css" />
<link href="~/assets/vendor/datatables.net-select-bs5/css/select.bootstrap5.min.css" rel="stylesheet" type="text/css" />

<!-- Theme Config Js -->
<script src="~/assets/js/config.js"></script>

<!-- App css -->
<link href="~/assets/css/app.min.css" rel="stylesheet" type="text/css" id="app-style" />

<!-- Icons css -->
<link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />

<div class="row p-2">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h3 class="page-title">@ViewData["Title"]</h3>
                <br />
                <!-- Add this dropdown ABOVE the table, inside card-body, after the "Add page" button div -->
                <div class="mb-3 d-flex gap-2 align-items-center">
                    <a href="@Url.Action("Create", "Page")" class="btn btn-primary">
                        <i class="ri-file-list-line"></i> Add page
                    </a>

                    <div style="width: 250px;">
                        <select id="productFilter"
                                class="form-select"
                                data-placeholder="-- All Products --">
                            <option value=""></option>
                        </select>
                    </div>

                    <!-- Reset button -->
                    <button id="resetFilter" class="btn btn-secondary">
                        <i class="ri-refresh-line"></i> Reset
                    </button>
                </div>
                <div class="table-responsive">
                    <table id="basic-datatable" class="table table-striped dt-responsive nowrap w-100">
                        <thead>
                            <tr>
                                <th>Page Name</th>
                                <th>Product</th>
                                <th>Active</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="pageEditModal" tabindex="-1" aria-labelledby="pageEditModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <!-- Initial loading content -->
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading page details...</p>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/vendor/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="~/assets/vendor/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
<script src="~/assets/vendor/datatables.net-select/js/dataTables.select.min.js"></script>
<script src="~/assets/vendor/datatables.net-keytable/js/dataTables.keyTable.min.js"></script>
<script src="~/assets/js/app.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>
    // Init Select2 with bootstrap-5 theme
    $('#productFilter').select2({
        placeholder: '-- All Products --',
        allowClear: true,
        width: '100%'
    });

    // Fetch products and populate
    $.ajax({
        url: '/Page/GetProductsForFilter',
        type: 'GET',
        success: function (products) {
            products.forEach(function (p) {
                $('#productFilter').append(new Option(p.text, p.value, false, false));
            });
        }
    });

    // Init DataTable
    var table = $('#basic-datatable').DataTable({
        processing: true,
        serverSide: true,
        ajax: {
            url: '/Page/GetPagesPaged',
            type: 'POST',
            data: function (d) {
                d.productId = $('#productFilter').val();
            }
        },
        columns: [
            { data: 'pageName' },
            { data: 'productName' },
            {
                data: 'isActive',
                render: function (data) {
                    return data === true || data === "Active"
                        ? '<span class="badge bg-success">Active</span>'
                        : '<span class="badge bg-danger">Inactive</span>';
                }
            },
            // Actions
            {
                data: 'id',
                orderable: false,
                searchable: false,
                className: 'text-center',

                render: function (data) {
                    return `
                        <div class="d-flex justify-content-center gap-1">

                            <!-- Edit -->
                            <button type="button"
                                    class="btn btn-sm btn-info edit-page-btn"
                                    data-page-id="${data}"
                                    title="Edit Page">
                                <i class="bi bi-pencil"></i>
                            </button>

                            <!-- Delete -->
                            <button type="button"
                                    class="btn btn-sm btn-danger delete-page-btn"
                                    data-page-id="${data}"
                                    title="Delete Page">
                                <i class="bi bi-trash"></i>
                            </button>

                        </div>
                    `;
                }
            }
        ],
        pageLength: 10,
        lengthMenu: [10, 25, 50, 100],
        orderable: true
    });

    // Change event covers both select and clear
    $('#productFilter').on('change', function () {
        table.ajax.reload();
    });

    $('#resetFilter').on('click', function () {
        $('#productFilter').val(null);                      
        $('#productFilter').trigger('change');              
        $('#productFilter').trigger('change.select2');      
        table.search('').draw();
    });
</script>

<script>
    $(document).ready(function () {
        const pageEditModal = new bootstrap.Modal(document.getElementById('pageEditModal'));
        const modalContent = $('#pageEditModal .modal-content');
        $('#basic-datatable').on('click', '.edit-page-btn', function () {
            const Id = $(this).data('page-id');

            if (!Id) {
                alert("Page ID is missing!");
                return;
            }
            modalContent.html(`
                <div class="modal-body text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading page details...</p>
                </div>
            `);

            pageEditModal.show();
            const url = '@Url.Action("LoadEditModal", "Page")/' + Id;

            $.ajax({
                url: url,
                type: 'GET',
                cache: false,
                success: function (partialViewHtml) {
                    modalContent.html(partialViewHtml);
                },
                error: function (xhr, status, error) {
                    console.error("AJAX error:", status, error);
                    modalContent.html(`
                        <div class="modal-header">
                            <h5 class="modal-title text-danger">Error Loading Data</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="m-0">Failed to load user details. Server responded with: ${xhr.status} (${xhr.statusText})</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    `);
                }
            });
        });
    });


</script>

<script>

    // ── Delete Menu ─────────────────────────────────────────
    $('#basic-datatable').on('click', '.delete-page-btn', function () {

        const id = $(this).data('page-id');

        // Validate ID
        if (!id) {

            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Page ID not found.'
            });

            return;
        }

        // Confirmation Alert
        Swal.fire({

            title: 'Delete Page?',
            text: 'This action cannot be undone.',
            icon: 'warning',

            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',

            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel'

        }).then((result) => {

            // Cancel
            if (!result.isConfirmed)
                return;

            // Loading
            Swal.fire({
                title: 'Deleting...',
                text: 'Please wait',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // AJAX Delete
            $.ajax({

                url: '/Page/DeletePage',
                type: 'POST',

                data: {
                    id: id
                },

                success: function (response) {

                    Swal.close();

                    // Success
                    if (response.success) {

                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted',
                            text: response.message,
                            timer: 1500,
                            showConfirmButton: false
                        });

                        // Reload DataTable
                        table.ajax.reload(null, false);

                    }
                    else {

                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message || 'Failed to delete Page.'
                        });

                    }

                },

                error: function () {

                    Swal.fire({
                        icon: 'error',
                        title: 'Server Error',
                        text: 'Something went wrong while deleting.'
                    });

                }

            });

        });

    });

</script>


