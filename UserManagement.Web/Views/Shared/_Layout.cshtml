                                <span>Users</span>
                                <span class="menu-arrow"></span>
                            </a>
                            <div class="collapse" id="sidebarUsers">
                                <ul class="side-nav-second-level">
                                    <li>
                                        <a class="menu-item" href="/User/Register">Register User</a>
                                    </li>
                                    <li>
                                        <a href="/User/Management">Users Management</a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                        <li class="side-nav-item">
                            <a data-bs-toggle="collapse" href="#sidebarDesignation" aria-expanded="false" aria-controls="sidebarDesignation" class="side-nav-link">
                                <i class="ri-vip-crown-2-line"></i>
                                <span>Designations</span>
                                <span class="menu-arrow"></span>
                            </a>
                            <div class="collapse" id="sidebarDesignation">
                                <ul class="side-nav-second-level">
                                    <li>
                                        <a class="menu-item" href="/Designation/Create">Create Designation</a>
                                    </li>
                                    <li>
                                        <a class="menu-item" href="/Designation/Management">Designation Management</a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                        <li class="side-nav-item">
