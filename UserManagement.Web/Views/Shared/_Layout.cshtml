                                    <li>
                                        <a href="/Page/Index">Create Page</a>
                                    </li>
                                    <li>
                                        <a class="menu-item" href="/Page/PagesManagement">Pages Management</a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                        <li class="side-nav-item">
                            <a data-bs-toggle="collapse" href="#sidebarRoles" aria-expanded="false" aria-controls="sidebarRoles" class="side-nav-link">
                                <i class="ri-shield-keyhole-line"></i>
                                <span>Roles</span>
                                <span class="menu-arrow"></span>
                            </a>
                            <div class="collapse" id="sidebarRoles">
                                <ul class="side-nav-second-level">
