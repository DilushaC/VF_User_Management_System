                                <span>Departments</span>
                                <span class="menu-arrow"></span>
                            </a>
                            <div class="collapse" id="sidebarDepartment">
                                <ul class="side-nav-second-level">
                                    <li>
                                        <a class="menu-item" href="/Department/Create">Create Department</a>
                                    </li>
                                    <li>
                                        <a class="menu-item" href="/Department/Management">Departments Management</a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                        <li class="side-nav-item">
                            <a data-bs-toggle="collapse" href="#sidebarProduct" aria-expanded="false" aria-controls="sidebarProduct" class="side-nav-link">
