                                <span>Page Permissions</span>
                                <span class="menu-arrow"></span>
                            </a>
                            <div class="collapse" id="sidebarRolePages">
                                <ul class="side-nav-second-level">
                                    <li>
                                        <a href="/Permission/Create">Create Permission</a>
                                    </li>
                                    <li>
                                        <a href="/Permission/Management">Permission Management</a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                        <li class="side-nav-item">
                            <a data-bs-toggle="collapse" href="#sidebarMenus" aria-expanded="false" aria-controls="sidebarRolePages" class="side-nav-link">
