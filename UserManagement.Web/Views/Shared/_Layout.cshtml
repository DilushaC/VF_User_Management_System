                                        @* Users Management *@
                                        @if (CanAccess("/User/UsersManagement"))
                                        {
                                            <li>
                                                <a href="/User/UsersManagement">Users Management</a>
                                            </li>
                                        }

                                    </ul>
                                </div>
                            </li>
                        }
                        @if (CanAccess("/Designation/Index") || CanAccess("/Designation/DesignationsManagement"))
