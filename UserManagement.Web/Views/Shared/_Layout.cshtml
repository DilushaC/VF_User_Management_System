                        <li class="side-nav-item">
                            <a data-bs-toggle="collapse" href="#sidebarUserRoles" aria-expanded="false" aria-controls="sidebarUserRoles" class="side-nav-link">
                                <i class="ri-key-line"></i>
                                <span>User Roles</span>
                                <span class="menu-arrow"></span>
                            </a>
                            <div class="collapse" id="sidebarUserRoles">
                                <ul class="side-nav-second-level">
                                    <li>
                                        <a href="/UserRole/Index">Create User Role</a>
                                    </li>
                                    <li>
                                        <a href="/UserRole/UserRolesManagement">User Roles Management</a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                        <li class="side-nav-item">
                            <a data-bs-toggle="collapse" href="#sidebarRolePages" aria-expanded="false" aria-controls="sidebarRolePages" class="side-nav-link">
                                <i class="ri-folder-keyhole-line"></i>
                                <span>Page Permissions</span>
                                <span class="menu-arrow"></span>
                            </a>
                            <div class="collapse" id="sidebarRolePages">
                                <ul class="side-nav-second-level">
