@using System.Text.Json
@using UserManagement.Data.Models

@{
    var username = Context.Session.GetString("UserName");
    var designation = Context.Session.GetString("Designation");
    var department = Context.Session.GetString("Department");
    var userId = Context.Session.GetString("UserId");
    var pageURLs = Context.Session.GetString("PageUrls");

    List<string> allowedPages = new List<string>();
    List<string> pagePermissions = new List<string>();
    List<string> iconClasses = new List<string>();

    if (!string.IsNullOrEmpty(pageURLs))
    {
        var allPages = JsonSerializer.Deserialize<List<string>>(pageURLs) ?? new List<string>();

        foreach (var p in allPages)
        {
            var parts = p.Split('|');
            var url = parts[0].StartsWith("/") ? parts[0] : "/" + parts[0];
            allowedPages.Add(url);
            iconClasses.Add(parts.Length > 1 ? parts[1] : "");
            pagePermissions.Add(parts.Length > 2 ? parts[2] : "false");
        }
    }

    var menuItems = allowedPages
        .Select((url, index) =>
        {
            var segments = url.Trim('/').Split('/');
            return new MenuItemModel
            {
                MenuTitle = segments[0],
                PageTitle = segments.Length > 1 ? segments[1] : segments[0],
                Url = url,
                IconClass = iconClasses[index],
                Permission = pagePermissions[index]
            };
        })
        .ToList();

    var menuGroups = menuItems
        .GroupBy(m => m.MenuTitle)
        .ToList();
}


<!DOCTYPE html>
<html lang="en">
<head>

    <link rel="shortcut icon" href="~/assets/images/favicon.ico">

    <link rel="stylesheet" href="~/assets/vendor/daterangepicker/daterangepicker.css">

    <link rel="stylesheet" href="~/assets/vendor/admin-resources/jquery.vectormap/jquery-jvectormap-1.2.2.css">

    <link href="~/assets/vendor/select2/css/select2.min.css" rel="stylesheet" type="text/css" />

    <link href="~/assets/vendor/bootstrap-touchspin/jquery.bootstrap-touchspin.min.css" rel="stylesheet" type="text/css" />

    <link href="~/assets/vendor/bootstrap-datepicker/css/bootstrap-datepicker.min.css" rel="stylesheet" type="text/css" />

    <link href="~/assets/vendor/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" type="text/css" />

    <link href="~/assets/vendor/flatpickr/flatpickr.min.css" rel="stylesheet" type="text/css" />

    <script src="~/assets/js/config.js"></script>

    <link href="~/assets/css/app.min.css" rel="stylesheet" type="text/css" id="app-style" />

    <link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />

</head>
<body>
    <div class="wrapper">
        <div>
            <div class="navbar-custom">
                <div class="topbar container-fluid">
                    <div class="d-flex align-items-center gap-lg-2 gap-1">
                        <div class="logo-topbar">
                            <a href="index.html" class="logo-dark">
                                <span class="logo-lg">
                                    <img src="~/assets/images/logo-dark.png" alt="dark logo">
                                </span>
                                <span class="logo-sm">
                                    <img src="~/assets/images/logo-sm.png" alt="small logo">
                                </span>
                            </a>
                        </div>
                        <button class="button-toggle-menu">
                            <i class="ri-menu-2-fill"></i>
                        </button>
                    </div>
                    <ul class="topbar-menu d-flex align-items-center gap-3">
                        <li class="d-none d-sm-inline-block">
                            <div class="nav-link" id="light-dark-mode" data-bs-toggle="tooltip" data-bs-placement="left" title="Theme Mode">
                                <i class="ri-moon-line fs-22"></i>
                            </div>
                        </li>
                        <li class="d-none d-md-inline-block">
                            <a class="nav-link" href="#" data-toggle="fullscreen">
                                <i class="ri-fullscreen-line fs-22"></i>
                            </a>
                        </li>

                        <li class="dropdown">
                            <a class="nav-link dropdown-toggle arrow-none nav-user px-2" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="false" aria-expanded="false">
                                <span class="account-user-avatar">
                                    <img src="~/assets/images/users/avatar-1.jpg" alt="user-image" width="32" class="rounded-circle">
                                </span>
                                <span class="d-lg-flex flex-column gap-1 d-none">
                                    <h5 class="my-0">@username</h5>
                                    <small class="text-muted" style="font-size: 11px; margin-top: -4px;">
                                        @designation - @department
                                    </small>
                                </span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-animated profile-dropdown">
                                <a href="pages-profile.html" class="dropdown-item">
                                    <i class="ri-account-circle-line fs-18 align-middle me-1"></i>
                                    <span>My Account</span>
                                </a>

                                <a href="pages-profile.html" class="dropdown-item">
                                    <i class="ri-settings-4-line fs-18 align-middle me-1"></i>
                                    <span>Settings</span>
                                </a>
                                <a href="/User/Login" class="dropdown-item">
                                    <i class="ri-logout-box-line fs-18 align-middle me-1"></i>
                                    <span>Logout</span>
                                </a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="leftside-menu">

                <a href="index.html" class="logo logo-light">
                    <span class="logo-lg">
                        <img src="~/assets/images/logo.png" alt="logo">
                    </span>
                    <span class="logo-sm">
                        <img src="~/assets/images/logo-sm.png" alt="small logo">
                    </span>
                </a>

                <a href="index.html" class="logo logo-dark">
                    <span class="logo-lg">
                        <img src="~/assets/images/logo-dark.png" alt="dark logo">
                    </span>
                    <span class="logo-sm">
                        <img src="~/assets/images/logo-sm.png" alt="small logo">
                    </span>
                </a>

                <div class="button-sm-hover" data-bs-toggle="tooltip" data-bs-placement="right" title="Show Full Sidebar">
                    <i class="ri-checkbox-blank-circle-line align-middle"></i>
                </div>

                <div class="button-close-fullsidebar">
                    <i class="ri-close-fill align-middle"></i>
                </div>

                <div class="h-100" id="leftside-menu-container" data-simplebar>
                    <ul class="side-nav">
                        <li class="side-nav-item">
                            <a href="/Home/Index" class="side-nav-link">
                                <i class="ri-home-4-line"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        @foreach (var menu in menuGroups)
                        {
                            <li class="side-nav-item">
                                <a data-bs-toggle="collapse" href="#@("sidebar" + menu.Key)" class="side-nav-link">
                                    <i class="ri-play-mini-line"></i>
                                    <span>@menu.Key</span>
                                    <span class="menu-arrow"></span>
                                </a>
                                <div class="collapse" id="@("sidebar" + menu.Key)">
                                    <ul class="side-nav-second-level">
                                        @foreach (var item in menu)
                                        {
                                            <li>
                                                <a href="@item.Url" class="menu-link" data-permission="@item.Permission">
                                                    <i class="@item.IconClass"></i> @item.PageTitle
                                                </a>
                                            </li>
                                        }

                                    </ul>
                                </div>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </div>
        <div class="content-page">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
        <footer class="footer">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-6">
                    </div>
                    <div class="col-md-6">
                        <div class="text-md-end footer-links d-none d-md-block">
                            <script>document.write(new Date().getFullYear())</script> © Vallibel Finance - UserManagement System
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/assets/lib/jquery/jquery.min.js"></script>

    @* <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> *@
    <script src="~/lib/jquery-validation/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>


    <script src="~/assets/js/vendor.min.js"></script>

    <script src="~/assets/vendor/daterangepicker/moment.min.js"></script>
    <script src="~/assets/vendor/daterangepicker/daterangepicker.js"></script>

    <script src="~/assets/vendor/admin-resources/jquery.vectormap/jquery-jvectormap-1.2.2.min.js"></script>
    <script src="~/assets/vendor/admin-resources/jquery.vectormap/maps/jquery-jvectormap-world-mill-en.js"></script>

    <script src="~/assets/js/pages/demo.dashboard.js"></script>

    <script src="~/assets/js/app.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        $(document).ready(function() {
            $(".menu-link").click(function(e) {
                e.preventDefault();
                var url = $(this).attr("href");
                var permission = $(this).data("permission");
                if (url.indexOf('?') > -1) {
                    url += '&permission=' + permission;
                } else {
                    url += '?permission=' + permission;
                }
                window.location.href = url;
            });
        });
    </script>



</body>
</html>