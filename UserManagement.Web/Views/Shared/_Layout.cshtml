                                    <span>Designations</span>
                                    <span class="menu-arrow"></span>
                                </a>
                                <div class="collapse" id="sidebarDesignation">
                                    <ul class="side-nav-second-level">

                                        @* Register User *@
                                        @if (CanAccess("/Designation/Index"))
                                        {
                                            <li>
                                                <a class="menu-item" href="/Designation/Index">Create Designation</a>
                                            </li>
                                        }

                                        @* Users Management *@
                                        @if (CanAccess("/Designation/DesignationsManagement"))
                                        {
                                            <li>
                                                <a href="/Designation/DesignationsManagement">Designations Management</a>
                                            </li>
                                        }

                                    </ul>
                                </div>
                            </li>
                        }
                        @if (CanAccess("/Branch/Index") || CanAccess("/Branch/BranchesManagement"))
                        {
                            <li class="side-nav-item">
                                <a data-bs-toggle="collapse" href="#sidebarBranch" aria-expanded="false" aria-controls="sidebarBranch" class="side-nav-link">
                                    <i class="ri-route-line"></i>
                                    <span>Branches</span>
                                    <span class="menu-arrow"></span>
                                </a>
                                <div class="collapse" id="sidebarBranch">
                                    <ul class="side-nav-second-level">

                                        @* Register User *@
                                        @if (CanAccess("/Branch/Index"))
                                        {
                                            <li>
                                                <a class="menu-item" href="/Branch/Index">Create Branch</a>
                                            </li>
                                        }

                                        @* Users Management *@
                                        @if (CanAccess("/Branch/BranchesManagement"))
                                        {
