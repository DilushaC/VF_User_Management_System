@using UserManagement.Data.Models
@model MenuItem
@{
    Layout = null;
}

<div class="modal-header">
    <h5 class="modal-title">
        Edit Menu: @Model.MenuTitle
        @if (Model.PageId == null || Model.PageId == 0)
        {
            <span class="badge bg-success ms-2">Has Submenus</span>
        }
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>


<form id="updateMenuForm" asp-action="UpdateMenuByIdAsync" asp-controller="Menu" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="modal-body">

        <!-- Menu Title -->
        <div class="mb-3 col-md-6">
            <label class="form-label">Menu Title</label>
            <input type="text" asp-for="MenuTitle" class="form-control" required />
        </div>

        <!-- Parent Menu -->
        <div class="row g-2" id="parentMenuContainer">
            <div class="mb-3 col-md-6">
                <label class="form-label">Parent Menu</label>
                <select id="ParentMenuItemId" name="ParentMenuItemId" class="form-control select2" data-placeholder="Select Parent Menu" asp-items="ViewBag.ParentMenus">
                    <option value="">Select Parent Menu</option>
                </select>
            </div>
        </div>

        <!-- Page -->
        <div class="row g-2" id="pageContainer">
            <div class="mb-3 col-md-6">
                <label class="form-label">Page</label>
                <select id="PageId" name="PageId" class="form-control select2" data-placeholder="Select Page" asp-items="ViewBag.Pages">
                    <option value="">Select Page</option>
                </select>
            </div>
        </div>

        <!-- Icon & Display Order -->
        <div class="row">
            <!-- Icon Class -->
            <div class="mb-3 col-md-6" id="iconClassContainer">
                <label class="form-label">Icon Class</label>
                <input type="text" asp-for="IconClass" class="form-control" />
            </div>

            <!-- Display Order -->
            <div class="mb-3 col-md-3" id="displayOrderContainer">
                <label asp-for="DisplayOrder" class="form-label d-flex justify-content-between">
                    <span>Display Order</span>
                </label>

                <input type="number"
                       asp-for="DisplayOrder"
                       id="DisplayOrder"
                       class="form-control"
                       min="1"
                       max="20"
                       step="1"
                       value="@Model.DisplayOrder" />

                <!-- Validation Message -->
                <small id="displayOrder-status" class="d-block mt-1 text-danger"></small>
            </div>

        </div>


        <!-- Product -->
        <div class="mb-3 col-md-6">
            <label class="form-label">Product</label>
            <select id="ProductId" asp-for="ProductId" class="form-control select2" asp-items="ViewBag.Products">
                <option value="">Select Product</option>
            </select>
        </div>

        <div class="mb-3 col-md-6">
            <label class="form-label">Category</label>
            <select id="CategoryId" asp-for="CategoryId" class="form-control select2" asp-items="ViewBag.Categories">
                <option value="">Select Category</option>
            </select>
        </div>

        <!-- Status -->
        <div class="mb-3 col-md-3">
            <label class="form-label">Status</label>
            <select id="Status" asp-for="IsActive" class="form-control select2">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
</form>

<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/vendor/select2/js/select2.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>

<script>
    $(document).ready(function () {

        // Initialize Select2
        $('#ParentMenuItemId, #PageId, #ProductId, #Status, #CategoryId').select2({ width: '100%' });

        const parentMenuContainer = $('#parentMenuContainer');
        const pageContainer = $('#pageContainer');
        const iconContainer = $('#iconClassContainer');
        const displayOrderContainer = $('#displayOrderContainer');

        const parentSelect = $('#ParentMenuItemId');
        const pageSelect = $('#PageId');
        const iconInput = $('#IconClass');
        const displayOrderInput = $('#DisplayOrder');
        const displayOrderStatus = $('#displayOrder-status'); // <-- validation message

        let displayOrderValid = true; // Track validity

        // Set initial values from model
        parentSelect.val('@Model.ParentMenuItemId').trigger('change');
        pageSelect.val('@Model.PageId').trigger('change');

        // Toggle fields depending on parent menu
        function toggleFields() {
            const parentVal = parentSelect.val();
            const pageVal = pageSelect.val();

            const isMainMenu = !parentVal || parentVal === "0";
            const showPageWhenParentNull = (!parentVal || parentVal === "0") && pageVal;

            if (isMainMenu) {
                parentMenuContainer.hide();
                iconContainer.show();
                displayOrderContainer.show();

                iconInput.attr('required', 'required');
                displayOrderInput.attr('required', 'required');
                parentSelect.removeAttr('required');

                if (showPageWhenParentNull) {
                    pageContainer.show();
                    pageSelect.attr('required', 'required');
                } else {
                    pageContainer.hide();
                    pageSelect.removeAttr('required');
                    pageSelect.val(null).trigger('change');
                }
            } else {
                parentMenuContainer.show();
                pageContainer.show();
                iconContainer.hide();
                displayOrderContainer.hide();

                iconInput.removeAttr('required');
                displayOrderInput.removeAttr('required');

                parentSelect.attr('required', 'required');
                pageSelect.attr('required', 'required');
            }
        }

        // Initial toggle
        toggleFields();

        // On Parent Menu change
        parentSelect.on('change', toggleFields);

        // Check display order availability on change
        displayOrderInput.on('change', function () {
            const displayOrder = $(this).val();
            const productId = $('#ProductId').val();
            const Id = $('#Id').val();

            if (!displayOrder || !productId) {
                displayOrderStatus.text('');
                displayOrderValid = false;
                return;
            }

            $.ajax({
                url: '/Page/CheckPageLevelForExistingMenu', // your backend endpoint
                type: 'POST',
                data: {
                    ProductId: productId,
                    DisplayOrder: displayOrder,
                    Id : Id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (res) {
                    if (res.exists === true) {
                        displayOrderValid = false;
                        displayOrderStatus
                            .text('❌ Display order already exists')
                            .removeClass('text-success')
                            .addClass('text-danger');
                    } else {
                        displayOrderValid = true;
                        displayOrderStatus
                            .text('✔ Display order available')
                            .removeClass('text-danger')
                            .addClass('text-success');
                    }
                },
                error: function () {
                    displayOrderValid = false;
                    displayOrderStatus.text('⚠ Unable to validate display order').removeClass('text-success').addClass('text-danger');
                }
            });
        });

        // Form submission
        $('#updateMenuForm').on('submit', function (e) {
            e.preventDefault();
            let form = $(this);

            if (!form[0].checkValidity()) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Missing Information',
                    text: 'Please fill in all required fields.'
                });
                return;
            }

            // Check display order before submit
            if (!displayOrderValid) {
                Swal.fire({
                    icon: 'error',
                    title: 'Invalid Display Order',
                    text: 'The selected display order already exists for this product.'
                });
                return;
            }

            Swal.fire({
                title: 'Update Menu?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Update',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Updating...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

                    $.ajax({
                        url: '/Menu/LoadEditModal',
                        type: 'POST',
                        data: form.serialize(),
                        headers: { "X-Requested-With": "XMLHttpRequest" },

                        success: function (response) {
                            Swal.close();

                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: response.message,
                                    showConfirmButton: false,
                                    timer: 1500
                                }).then(() => {
                                    window.location.href = response.redirectUrl;
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: response.message || 'Failed to create menu.'
                                });
                            }
                        },

                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Something went wrong! Please try again.'
                            });
                        }
                    });
                }
            });
        });

    });
</script>

