@model UserManagement.Data.Models.MenuItem

@{
    ViewData["Title"] = "Create Menu Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var displayOrder = Model?.DisplayOrder > 0 ? Model.DisplayOrder : 1;
}

<div class="row">
    <div class="row p-2">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h3 class="header">@ViewData["Title"]</h3>
                    <br />

                    <form asp-action="Create" asp-controller="Menu" method="post" id="RegisterForm" autocomplete="off" novalidate>
                        <fieldset>

                            <!-- Product -->
                            <div id="productContainer" class="row g-2">
                                <div class="mb-3 col-md-6">
                                    <label class="form-label">Select Product</label>
                                    <select id="ProductId"
                                            asp-for="ProductId"
                                            class="form-control select2 round"
                                            required
                                            data-placeholder="Select Base Product"
                                            asp-items="ViewBag.Products">
                                        <option value="">Select Base Product</option>
                                    </select>
                                    <small id="productId-status" class="form-text"></small>
                                </div>
                            </div>

                            <!-- Menu Details (hidden until product selected) -->
                            <div id="menuDetailsContainer" class="d-none">

                                <!-- Menu Title -->
                                <div class="row g-2">
                                    <div class="mb-3 col-md-6">
                                        <label asp-for="MenuTitle" class="form-label">Menu Title</label>
                                        <input asp-for="MenuTitle"
                                               id="MenuTitle"
                                               class="form-control round"
                                               required
                                               autocomplete="off" />
                                        <small id="menuTitle-status" class="form-text"></small>
                                    </div>
                                </div>

                                <!-- Checkboxes -->
                                <div class="row g-2">
                                    <div class="mb-3 col-md-3 form-check">
                                        <input type="checkbox" class="form-check-input" id="IsMainMenu" name="IsMainMenu">
                                        <label class="form-check-label" for="IsMainMenu">This is a Main Menu</label>
                                    </div>
                                    <div class="mb-3 col-md-3 form-check">
                                        <input type="checkbox" class="form-check-input" id="NoSubMenus" name="NoSubMenus">
                                        <label class="form-check-label" for="NoSubMenus">No Sub Menus</label>
                                    </div>
                                </div>

                            </div>

                            <!-- Pages -->
                            <div id="pageContainer" class="row g-2">
                                <div class="mb-3 col-md-6">
                                    <label asp-for="PageId" class="form-label">Page Name</label>
                                    <select asp-for="PageId"
                                            id="PageIds"
                                            class="form-control select2 round"
                                            asp-items="ViewBag.Pages"
                                            required>
                                        <option value=""></option>
                                    </select>
                                    <small id="pageIds-status" class="form-text"></small>
                                </div>
                            </div>

                            <!-- Parent Menu -->
                            <div id="parentMenuContainer" class="row g-2">
                                <div class="mb-3 col-md-6">
                                    <label class="form-label">Select Parent Menu</label>
                                    <select id="ParentMenuItemId"
                                            asp-for="ParentMenuItemId"
                                            class="form-control select2 round"
                                            required
                                            data-placeholder="Select Parent Menu"
                                            asp-items="ViewBag.ParentMenus">
                                        <option value="">Select Parent Menu</option>
                                    </select>
                                    <small id="parentMenuItemId-status" class="form-text"></small>
                                </div>
                            </div>

                            <!-- Category -->
                            <div id="categoryContainer" class="row g-2 d-none">
                                <div class="mb-3 col-md-6">
                                    <label class="form-label">Select Category</label>
                                    <select id="CategoryId"
                                            asp-for="CategoryId"
                                            class="form-control select2 round"
                                            asp-items="ViewBag.Categories">
                                    </select>
                                </div>
                            </div>

                            <!-- Display Order -->
                            <div id="displayOrderContainer" class="row g-2">
                                <div class="mb-3 col-md-2">
                                    <label asp-for="DisplayOrder" class="form-label">Display Order</label>
                                    <input type="number"
                                           asp-for="DisplayOrder"
                                           id="DisplayOrder"
                                           class="form-control w-75"
                                           min="1"
                                           max="20"
                                           step="1"
                                           value="@displayOrder" />
                                    <small id="displayOrder-status" class="form-text d-block mt-1"></small>
                                </div>
                            </div>

                            <!-- Icon Class -->
                            <div id="iconClassContainer" class="row g-2 d-none">
                                <div class="mb-3 col-md-2">
                                    <label class="form-label">Icon Class</label>
                                    <input id="IconClass" name="IconClass" class="form-control round" />
                                </div>
                            </div>

                            <!-- Active Status -->
                            <div class="row g-2">
                                <div class="mb-3 col-md-2">
                                    <label class="form-label">Active Status</label>
                                    <select id="IsActive" name="IsActive" class="form-select select2">
                                        <option value="true">Active</option>
                                        <option value="false">Inactive</option>
                                    </select>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary">Create Menu Item</button>

                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>

    // ── Helper ────────────────────────────────────────────────────────────────
    function setMsg(id, text, isError) {
        $("#" + id).html(text
            ? '<span style="color:' + (isError ? 'red' : 'green') + ';">' +
              (isError ? '❌ ' : '✔ ') + text + '</span>'
            : '');
    }

    // ── Select2 Init ──────────────────────────────────────────────────────────
    $("#ProductId").select2({ placeholder: "Select Product", allowClear: true });
    $("#ParentMenuItemId").select2({ placeholder: "Select Parent Menu", allowClear: true });
    $("#PageIds").select2({ placeholder: "Select Page", allowClear: true });
    $("#CategoryId").select2({ placeholder: "Select Category", allowClear: true });
    $("#IsActive").select2({ placeholder: "Select Status" });

    // ── Tracking flags ────────────────────────────────────────────────────────
    let menuTitleValid = false;
    let displayOrderValid = true; // optional field — defaults to valid

    // ── Product: load pages + show menu details ───────────────────────────────
    $("#ProductId").on("change", function () {
        const productId = $(this).val();

        if (productId) {
            setMsg('productId-status', 'Product selected.', false);
            $("#menuDetailsContainer").removeClass("d-none");

            // Load pages for selected product
            $.ajax({
                url: '/Permission/GetPagesByProduct',
                type: 'GET',
                data: { productId: productId },
                success: function (response) {
                    if (response.success) {
                        $("#PageIds").empty();
                        response.data.forEach(page => {
                            $("#PageIds").append(new Option(page.pageName, page.id));
                        });
                        $("#PageIds").trigger('change');
                    }
                }
            });
        } else {
            setMsg('productId-status', 'Please select a product.', true);
            $("#menuDetailsContainer").addClass("d-none");
            $("#MenuTitle").val("");
            setMsg('menuTitle-status', '', false);
            menuTitleValid = false;
            $("#IsMainMenu").prop("checked", false);
            $("#NoSubMenus").prop("checked", false);
            $("#PageIds").empty().trigger('change');
        }
    });

    // ── Menu Title validation ─────────────────────────────────────────────────
    $("#MenuTitle").on("blur", function () {
        const menuTitle = $(this).val().trim();
        const productId = $("#ProductId").val();

        if (menuTitle.length === 0) {
            setMsg('menuTitle-status', 'Menu Title is required.', true);
            menuTitleValid = false;
            return;
        }

        if (menuTitle.length < 2) {
            setMsg('menuTitle-status', 'Minimum 2 characters required.', true);
            menuTitleValid = false;
            return;
        }

        if (!productId) {
            setMsg('menuTitle-status', 'Please select a product first.', true);
            menuTitleValid = false;
            return;
        }

        $.ajax({
            url: "/Menu/CheckMenuTitle",
            type: "POST",
            data: { ProductId: productId, MenuTitle: menuTitle },
            success: function (response) {
                if (response.exists) {
                    setMsg('menuTitle-status', 'Menu title already exists.', true);
                    menuTitleValid = false;
                } else {
                    setMsg('menuTitle-status', 'Menu title available.', false);
                    menuTitleValid = true;
                }
            },
            error: function () {
                setMsg('menuTitle-status', 'Unable to validate menu title.', true);
                menuTitleValid = false;
            }
        });
    });

    // ── Display Order validation ──────────────────────────────────────────────
    $("#DisplayOrder").on("change", function () {
        const displayOrder = $(this).val();
        const productId = $("#ProductId").val();
        const categoryId = $("#CategoryId").val();

        if (!displayOrder || !productId) {
            setMsg('displayOrder-status', '', false);
            displayOrderValid = true; // not blocking if field hidden/empty
            return;
        }

        $.ajax({
            url: '/Page/CheckPageLevel',
            type: 'POST',
            data: {
                displayOrder: displayOrder,
                productId: productId,
                categoryId: categoryId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (res) {
                if (res.exists) {
                    setMsg('displayOrder-status', 'Display order already used.', true);
                    displayOrderValid = false;
                } else {
                    setMsg('displayOrder-status', 'Display order available.', false);
                    displayOrderValid = true;
                }
            },
            error: function () {
                setMsg('displayOrder-status', 'Unable to validate display order.', true);
                displayOrderValid = false;
            }
        });
    });

    // ── Checkbox toggle logic ─────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', function () {

        const isMainMenu         = document.getElementById('IsMainMenu');
        const noSubMenus         = document.getElementById('NoSubMenus');
        const parentMenuContainer   = document.getElementById('parentMenuContainer');
        const pageContainer         = document.getElementById('pageContainer');
        const productContainer      = document.getElementById('productContainer');
        const iconContainer         = document.getElementById('iconClassContainer');
        const displayOrderContainer = document.getElementById('displayOrderContainer');
        const categoryContainer     = document.getElementById('categoryContainer');
        const parentSelect          = document.getElementById('ParentMenuItemId');
        const pageSelect            = document.getElementById('PageIds');
        const iconInput             = document.getElementById('IconClass');
        const displayOrderInput     = document.getElementById('DisplayOrder');
        const categorySelect        = document.getElementById('CategoryId');

        function resetSelect(el, selector) {
            el.value = null;
            $(selector).val(null).trigger('change');
            el.removeAttribute('required');
        }

        function resetInputs() {
            iconInput.value = '';
            displayOrderInput.value = '';
            iconInput.removeAttribute('required');
            displayOrderInput.removeAttribute('required');
            pageSelect.removeAttribute('required');
            parentSelect.removeAttribute('required');
        }

        function toggleMenus() {
            resetInputs();

            // Always hide category by default
            categoryContainer.classList.add('d-none');
            categorySelect.removeAttribute('required');

            // ── No Sub Menus ──────────────────────────────────────────────────
            if (noSubMenus.checked) {
                isMainMenu.checked = true;
                parentMenuContainer.classList.add('d-none');
                productContainer.classList.remove('d-none');
                pageContainer.classList.remove('d-none');
                iconContainer.classList.remove('d-none');
                displayOrderContainer.classList.remove('d-none');
                categoryContainer.classList.remove('d-none');
                categorySelect.setAttribute('required', 'required');
                resetSelect(parentSelect, "#ParentMenuItemId");
                pageSelect.setAttribute('required', 'required');
                iconInput.setAttribute('required', 'required');
                displayOrderInput.setAttribute('required', 'required');
                return;
            }

            // ── Main Menu ─────────────────────────────────────────────────────
            if (isMainMenu.checked) {
                noSubMenus.checked = false;
                parentMenuContainer.classList.add('d-none');
                pageContainer.classList.add('d-none');
                productContainer.classList.remove('d-none');
                iconContainer.classList.remove('d-none');
                displayOrderContainer.classList.remove('d-none');
                categoryContainer.classList.remove('d-none');
                categorySelect.setAttribute('required', 'required');
                resetSelect(parentSelect, "#ParentMenuItemId");
                resetSelect(pageSelect, "#PageIds");
                iconInput.setAttribute('required', 'required');
                displayOrderInput.setAttribute('required', 'required');
                return;
            }

            // ── Sub Menu ──────────────────────────────────────────────────────
            noSubMenus.checked = false;
            parentMenuContainer.classList.remove('d-none');
            pageContainer.classList.remove('d-none');
            productContainer.classList.remove('d-none');
            iconContainer.classList.add('d-none');
            displayOrderContainer.classList.add('d-none');
            parentSelect.setAttribute('required', 'required');
            pageSelect.setAttribute('required', 'required');
        }

        toggleMenus();
        isMainMenu.addEventListener('change', toggleMenus);
        noSubMenus.addEventListener('change', toggleMenus);

        // ── Form Submit ───────────────────────────────────────────────────────
        $("#RegisterForm").on("submit", function (e) {
            e.preventDefault();

            let isValid = true;

            // Validate product
            if (!$("#ProductId").val()) {
                setMsg('productId-status', 'Please select a product.', true);
                isValid = false;
            }

            // Validate menu title (only if visible)
            if ($("#menuDetailsContainer").is(":visible") || !$("#menuDetailsContainer").hasClass("d-none")) {
                if ($("#MenuTitle").val().trim() === '') {
                    setMsg('menuTitle-status', 'Menu Title is required.', true);
                    menuTitleValid = false;
                }
                if (!menuTitleValid) isValid = false;
            }

            // Validate display order
            if (!displayOrderValid) isValid = false;

            if (!isValid) return;

            // Confirm then submit
            Swal.fire({
                title: 'Create Menu?',
                text: 'Are you sure you want to create?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save',
                cancelButtonText: 'Cancel'
            }).then((result) => {

                if (!result.isConfirmed) return;

                Swal.fire({
                    title: 'Saving...',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });

                $.ajax({
                    url: '/Menu/Create',
                    type: 'POST',
                    data: $("#RegisterForm").serialize(),
                    headers: { "X-Requested-With": "XMLHttpRequest" },

                    success: function (response) {
                        Swal.close();

                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: response.message,
                                showConfirmButton: false,
                                timer: 1500
                            }).then(() => {
                                window.location.href = response.redirectUrl;
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Failed to create menu.'
                            });
                        }
                    },

                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong! Please try again.'
                        });
                    }
                });
            });
        });
    });

</script>