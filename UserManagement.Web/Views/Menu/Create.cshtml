@model UserManagement.Data.Models.MenuItem

@{
    ViewData["Title"] = "Create Menu Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="row p-2">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h3 class="header">@ViewData["Title"]</h3>
                    <br />
                    <form asp-action="Create" asp-controller="Page" method="post" id="RegisterForm" novalidate>
                        <fieldset>
                            <div class="row g-2">
                                <div class="mb-3 col-md-6 position-relative">
                                    <label asp-for="MenuTitle" class="form-label">Menu Title</label>
                                    <input asp-for="MenuTitle" class="form-control round" required
                                           data-bs-toggle="tooltip" data-bs-placement="right" title="Menu name is required" />
                                    <span asp-validation-for="MenuTitle" class="invalid-tooltip">Menu name is required</span>
                                    <small id="menuTitle-status"></small>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="mb-3 col-md-6 position-relative form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="IsMainMenu"
                                           name="IsMainMenu" />

                                    <label class="form-check-label" for="IsMainMenu">
                                        This is a Main Menu
                                    </label>
                                </div>
                            </div>
                            <div id="parentMenuContainer" class="row g-2">
                                <div class="mb-3 col-md-6 position-relative">
                                    <label asp-for="ParentMenuItemId" class="form-label">
                                        Select Parent Menu
                                    </label>
                                    <select id="ParentMenuItemId"
                                            asp-for="ParentMenuItemId"
                                            class="form-control select2 round"
                                            asp-items="ViewBag.Products">
                                        <option value="">Select Parent</option>
                                    </select>
                                    <span asp-validation-for="ParentMenuItemId"
                                          class="invalid-tooltip">
                                        Parent Menu is required
                                    </span>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="mb-3 col-md-6 position-relative">
                                    <label asp-for="ProductId" class="form-label">Select Product</label>
                                    <select id="ProductId"
                                            asp-for="ProductId"
                                            class="form-control select2 round"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="right"
                                            title="Product is required"
                                            required
                                            data-placeholder="Select Product"
                                            asp-items="ViewBag.Products">
                                        <option value="">Select Product</option>
                                    </select>
                                    <span asp-validation-for="ProductId" class="invalid-tooltip">Product is required</span>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="mb-3 form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="IsDropdownMenu" />

                                    <label class="form-check-label" for="IsDropdownMenu">
                                        This menu is a Dropdown (no page)
                                    </label>
                                </div>
                            </div>
                            <div id="pageContainer" class="row g-2">
                                <div class="mb-3 col-md-6 position-relative">
                                    <label asp-for="PageId" class="form-label">Select Page</label>

                                    <select id="PageId"
                                            asp-for="PageId"
                                            class="form-control select2 round"
                                            asp-items="ViewBag.Pages">
                                        <option value="">Select Page</option>
                                    </select>

                                    <span asp-validation-for="PageId"
                                          class="invalid-tooltip">
                                        Page is required
                                    </span>
                                </div>
                            </div>

                            <div id="iconClassContainer" class="row g-2" style="display:none;">
                                <div class="mb-3 col-md-2 position-relative">
                                    <label asp-for="IconClass" class="form-label">Icon Class</label>
                                    <input asp-for="IconClass"
                                           id="IconClass"
                                           class="form-control round"
                                           data-bs-toggle="tooltip"
                                           data-bs-placement="right"
                                           title="Icon Class is required" />
                                    <span asp-validation-for="IconClass"
                                          class="invalid-tooltip">
                                        Icon Class is required
                                    </span>
                                </div>
                            </div>

                            <div class="row g-2">
                                <div class="mb-3 col-md-1 position-relative">
                                    <label asp-for="DisplayOrder" class="form-label">Page Level</label>
                                    <input asp-for="DisplayOrder" type="number" class="form-control round" required min="1"
                                           data-bs-toggle="tooltip" data-bs-placement="right" title="Product Selection is required" disabled />
                                    <span asp-validation-for="DisplayOrder" class="invalid-tooltip">Display Order is required</span>
                                    <small id="displayOrder-status"></small>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="mb-3 col-md-2">
                                    <label asp-for="IsActive" class="form-label">Active Status</label>
                                    <select asp-for="IsActive" class="form-select">
                                        <option value="true">Active</option>
                                        <option value="false">Inactive</option>
                                    </select>
                                    <span asp-validation-for="IsActive" class="text-danger"></span>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">Create Menu Item</button>
                        </fieldset>
                    </form>
                </div> <!-- end card-body -->
            </div> <!-- end card-->
        </div> <!-- end col -->
    </div>
</div>
<!-- Load jQuery only ONCE -->
<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>
<!-- Load Select2 JS -->
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>
    $("#ParentMenuItemId").select2({
        placeholder: "Select Parent Menu",
    });

    $("#ProductId").select2({
        placeholder: "Select Product",
    });

    $("#PageId").select2({
        placeholder: "Select Page",
    });

    $("#ProductId").on('change', function () {
        var productId = $(this).val();
        if (productId) {
            $("#PageId").prop('disabled', false);
            $("#PageId").val('');
        } else {
            $("#PageId").prop('disabled', true);   // Keep disabled if no product selected
            $("#PageId").val('');                   // Optional: clear value
        }
    });


    let pageNameValid = false;
    let pageLevelValid = false;

    $("#PageName").on('blur', function () {
    let pageName = $(this).val().trim();

        if (pageName.length < 3) {
            $("#pageName-status").html(`<span style="color:gray;">Minimum 3 characters required</span>`);
            pageNameValid = false;
            return;
        }

        $.ajax({
            url: '/Page/CheckPageName',
            type: 'POST',
            data: { pageName: pageName },
            success: function (res) {
                if (res.exists) {
                    pageNameValid = false;
                    $("#pageName-status").html(`<span style="color:red;">❌ Page already exists</span>`);
                } else {
                    pageNameValid = true;
                    $("#pageName-status").html(`<span style="color:green;">✔ Page available</span>`);
                }
            }
        });
    });

    $("#PageLevel").on('blur', function () {
    let pageLevel = $(this).val().trim();
    var productId = $("#ProductId").val();
        $.ajax({
            url: '/Page/CheckPageLevel',
            type: 'POST',
            data: { pageLevel: pageLevel,productId: productId },
            success: function (res) {
                if (res.exists) {
                    pageLevelValid = false;
                    $("#pageLevel-status").html(`<span style="color:red;">❌ Page Level exists</span>`);
                } else {
                    pageLevelValid = true;
                    $("#pageLevel-status").html(`<span style="color:green;">✔ Page Level available</span>`);
                }
            }
        });
    });

    $("#RegisterForm").on("submit", function (e) {
        e.preventDefault();
        let form = $(this)[0];

        if (!pageNameValid) {
            Swal.fire({
                icon: 'error',
                title: 'Page Already Exists',
                text: 'Please Create another Page.'
            });
            return;
        }

        if (!pageLevelValid) {
            Swal.fire({
                icon: 'error',
                title: 'Page Level Already Exists',
                text: 'Please choose another Page Level.'
            });
            return;
        }

        if (!form.checkValidity()) {
            $(this).addClass('was-validated');
            return;
        }
        Swal.fire({
            title: 'Create Page?',
            text: "Are you sure you want to create?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Save',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Saving...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                $.ajax({
                    url: '/Menu/Create',
                    type: 'POST',
                    data: $("#RegisterForm").serialize(),
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: function (response) {
                        Swal.close();
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: response.message,
                                showConfirmButton: false,
                                timer: 1500
                            }).then(() => {
                                window.location.href = response.redirectUrl;
                                // Reset form and Select2 elements
                            });
                        } else if (response.redirectUrl) {
                            // Redirect if controller provides URL
                            window.location.href = response.redirectUrl;
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Failed to create page.'
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong! Please try again.'
                        });
                    }
                });
            }
        });
    });

    document.getElementById('IsMainMenu').addEventListener('change', function () {
    const container = document.getElementById('parentMenuContainer');
    const parentSelect = document.getElementById('ParentMenuItemId');

    if (this.checked) {
        container.style.display = 'none';
        parentSelect.value = ''; 
        parentSelect.removeAttribute('required');
    } else {
        container.style.display = '';
        parentSelect.setAttribute('required', 'required');
        }
    });


    const dropdownCheckbox = document.getElementById('IsDropdownMenu');
    const pageContainer = document.getElementById('pageContainer');
    const pageSelect = document.getElementById('PageId');

    dropdownCheckbox.addEventListener('change', function () {
        if (this.checked) {
            pageContainer.style.display = 'none';
            pageSelect.value = '';
            pageSelect.removeAttribute('required');
        } else {
            pageContainer.style.display = '';
            pageSelect.setAttribute('required', 'required');
        }
    });

    // Handle edit mode on load
    window.addEventListener('DOMContentLoaded', () => {
        dropdownCheckbox.dispatchEvent(new Event('change'));
    });


    document.addEventListener('DOMContentLoaded', function () {

        const checkbox = document.getElementById('IsDropdownMenu');
        const iconContainer = document.getElementById('iconClassContainer');
        const iconInput = document.getElementById('IconClass');

        function toggleIconClass() {
            if (checkbox.checked) {
                iconContainer.style.display = '';
                iconInput.setAttribute('required', 'required');
            } else {
                iconContainer.style.display = 'none';
                iconInput.value = '';
                iconInput.removeAttribute('required');
            }
        }

        // run once on page load (start hidden)
        toggleIconClass();

        // run on checkbox change
        checkbox.addEventListener('change', toggleIconClass);
    });


</script>

