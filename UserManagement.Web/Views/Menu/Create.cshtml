@model UserManagement.Data.Models.MenuItem

@{
    ViewData["Title"] = "Create Menu Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="row p-2">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h3 class="header">@ViewData["Title"]</h3>
                    <br />

                    <form asp-action="Create" asp-controller="Page" method="post" id="RegisterForm" novalidate>
                        <input type="hidden" id="PageId" name="PageId" />
                        <fieldset>
                            <!-- Menu Title -->
                            <div class="row g-2">
                                <div class="mb-3 col-md-6">
                                    <label asp-for="MenuTitle" class="form-label">Menu Title</label>
                                    <input asp-for="MenuTitle" class="form-control round" required />
                                    <span asp-validation-for="MenuTitle" class="invalid-tooltip"></span>
                                </div>
                            </div>

                            <!-- Is Main Menu -->
                            <div class="row g-2">
                                <div class="mb-3 col-md-6 form-check">
                                    <input type="checkbox" class="form-check-input" id="IsMainMenu" name="IsMainMenu">
                                    <label class="form-check-label" for="IsMainMenu">
                                        This is a Main Menu
                                    </label>
                                </div>
                            </div>

                            <!-- Product -->
                            <div id="productContainer" class="row g-2">
                                <div class="mb-3 col-md-6">
                                    <label class="form-label">Select Product</label>
                                    <select id="ProductId"
                                            asp-for="ProductId"
                                            class="form-control select2 round"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="right"
                                            title="Product is required"
                                            required
                                            data-placeholder="Select Base Product"
                                            asp-items="ViewBag.Products">
                                        <option value="">Select Base Product</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Pages -->
                            <div id="pageContainer" class="row g-2">
                                <div class="mb-3 col-md-6">
                                    <label class="form-label">Page Name</label>
                                    <select id="PageIds"
                                            asp-for="PageId"
                                            class="form-control select2 round"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="right"
                                            title="Page is required"
                                            required
                                            data-placeholder="Select Page"
                                            asp-items="ViewBag.Pages">
                                        <option value="">Select Page</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Parent Menu -->
                            <div id="parentMenuContainer" class="row g-2">
                                <div class="mb-3 col-md-6">
                                    <label class="form-label">Select Parent Menu</label>
                                    <select id="ParentMenuItemId"
                                            asp-for="ParentMenuItemId"
                                            class="form-control select2 round"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="right"
                                            title="Parent Menu required"
                                            required
                                            data-placeholder="Select Parent Menu"
                                            asp-items="ViewBag.ParentMenus">
                                        <option value="">Select Parent Menu</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Icon Class -->
                            <div id="iconClassContainer" class="row g-2 d-none">
                                <div class="mb-3 col-md-2">
                                    <label class="form-label">Icon Class</label>
                                    <input id="IconClass" name="IconClass"
                                           class="form-control round" />
                                </div>
                            </div>

                            <!-- Menu Level -->
                            <div id="displayOrderContainer" class="row g-2 d-none">
                                <div class="mb-3 col-md-2">
                                    <label class="form-label">Menu Level</label>
                                    <input id="DisplayOrder" name="DisplayOrder"
                                           type="number"
                                           class="form-control round"
                                           min="1" />
                                </div>
                            </div>

                            <!-- Status -->
                            <div class="row g-2">
                                <div class="mb-3 col-md-2">
                                    <label class="form-label">Active Status</label>
                                    <select name="IsActive" class="form-select">
                                        <option value="true">Active</option>
                                        <option value="false">Inactive</option>
                                    </select>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                Create Menu Item
                            </button>

                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Load jQuery only ONCE -->
<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>
<!-- Load Select2 JS -->
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>
    $("#ParentMenuItemId").select2({
        placeholder: "Select Parent Menu",
        allowClear: true
    });

    $("#ProductId").select2({
        placeholder: "Select Product",
        allowClear: true
    });

    $("#PageIds").select2({
        placeholder: "Select Page",
        allowClear: true,
    });

    $("#ProductId").on('change', function () {
        var productId = $(this).val();
        if (productId) {
            $("#PageId").prop('disabled', false);
            $("#PageId").val('');
        } else {
            $("#PageId").prop('disabled', true);   // Keep disabled if no product selected
            $("#PageId").val('');                   // Optional: clear value
        }
    });


    let pageNameValid = false;
    let pageLevelValid = false;

    $("#PageName").on('blur', function () {
    let pageName = $(this).val().trim();

        if (pageName.length < 3) {
            $("#pageName-status").html(`<span style="color:gray;">Minimum 3 characters required</span>`);
            pageNameValid = false;
            return;
        }

        $.ajax({
            url: '/Page/CheckPageName',
            type: 'POST',
            data: { pageName: pageName },
            success: function (res) {
                if (res.exists) {
                    pageNameValid = false;
                    $("#pageName-status").html(`<span style="color:red;">❌ Page already exists</span>`);
                } else {
                    pageNameValid = true;
                    $("#pageName-status").html(`<span style="color:green;">✔ Page available</span>`);
                }
            }
        });
    });

    $("#PageLevel").on('blur', function () {
    let pageLevel = $(this).val().trim();
    var productId = $("#ProductId").val();
        $.ajax({
            url: '/Page/CheckPageLevel',
            type: 'POST',
            data: { pageLevel: pageLevel,productId: productId },
            success: function (res) {
                if (res.exists) {
                    pageLevelValid = false;
                    $("#pageLevel-status").html(`<span style="color:red;">❌ Page Level exists</span>`);
                } else {
                    pageLevelValid = true;
                    $("#pageLevel-status").html(`<span style="color:green;">✔ Page Level available</span>`);
                }
            }
        });
    });

    $("#ProductId").on("change", function () {
        let productId = $(this).val();
        if (productId) {
            $.ajax({
                url: '/Permission/GetPagesByProduct',
                type: 'GET',
                data: { productId: productId },
                success: function (response) {
                    if (response.success) {
                        $("#PageIds").empty();
                        response.data.forEach(page => {
                            $("#PageIds").append(
                                new Option(page.pageName, page.id)
                            );
                        });
                        $("#PageIds").trigger('change');
                    }
                }
            });
        } else {
            $("#PageIds").empty().trigger('change');
        }
    });


    document.addEventListener('DOMContentLoaded', function () {

        const isMainMenu = document.getElementById('IsMainMenu');

        const parentMenuContainer = document.getElementById('parentMenuContainer');
        const pageContainer = document.getElementById('pageContainer');
        const iconContainer = document.getElementById('iconClassContainer');
        const displayOrderContainer = document.getElementById('displayOrderContainer');

        const parentSelect = document.getElementById('ParentMenuItemId');
        const pageSelect = document.getElementById('PageIds');
        const iconInput = document.getElementById('IconClass');
        const displayOrderInput = document.getElementById('DisplayOrder');
        const hiddenPageId = document.getElementById('PageId');

        /* ===============================
           TOGGLE UI BASED ON CHECKBOX
        ================================ */
        function toggleMainMenu() {

            if (isMainMenu.checked) {
                // ===== MAIN MENU =====

                parentMenuContainer.classList.add('d-none');
                pageContainer.classList.add('d-none');

                iconContainer.classList.remove('d-none');
                displayOrderContainer.classList.remove('d-none');

                parentSelect.value = '';
                pageSelect.value = null;

                parentSelect.removeAttribute('required');
                pageSelect.removeAttribute('required');

                iconInput.setAttribute('required', 'required');
                displayOrderInput.setAttribute('required', 'required');

                // 🔥 FORCE PAGE ID = 1
                hiddenPageId.value = 1;

            } else {
                // ===== SUB MENU =====

                parentMenuContainer.classList.remove('d-none');
                pageContainer.classList.remove('d-none');

                iconContainer.classList.add('d-none');
                displayOrderContainer.classList.add('d-none');

                iconInput.value = '';
                displayOrderInput.value = '';

                iconInput.removeAttribute('required');
                displayOrderInput.removeAttribute('required');

                parentSelect.setAttribute('required', 'required');
                pageSelect.setAttribute('required', 'required');

                hiddenPageId.value = '';
            }
        }

        toggleMainMenu();
        isMainMenu.addEventListener('change', toggleMainMenu);

        $("#RegisterForm").on("submit", function (e) {
            e.preventDefault();

            let form = this;

            if (!form.checkValidity()) {
                $(form).addClass('was-validated');
                return;
            }

            if (isMainMenu.checked) {
                hiddenPageId.value = 1;
            } else {
                const selectedPages = $("#PageIds").val();
                hiddenPageId.value = selectedPages && selectedPages.length > 0
                    ? selectedPages[0]
                    : '';
            }

            Swal.fire({
                title: 'Create Menu?',
                text: "Are you sure you want to create?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save',
                cancelButtonText: 'Cancel'
            }).then((result) => {

                if (result.isConfirmed) {

                    Swal.fire({
                        title: 'Saving...',
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });

                    $.ajax({
                        url: '/Menu/Create',
                        type: 'POST',
                        data: $("#RegisterForm").serialize(),
                        headers: { "X-Requested-With": "XMLHttpRequest" },

                        success: function (response) {
                            Swal.close();

                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: response.message,
                                    showConfirmButton: false,
                                    timer: 1500
                                }).then(() => {
                                    window.location.href = response.redirectUrl;
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: response.message || 'Failed to create menu.'
                                });
                            }
                        },

                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Something went wrong! Please try again.'
                            });
                        }
                    });
                }
            });
        });
    });
</script>


