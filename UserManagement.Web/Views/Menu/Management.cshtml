@using UserManagement.Data.Models
@{
    ViewData["Title"] = "Menu Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Datatables css -->
<link href="~/assets/vendor/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet" type="text/css" />
<link href="~/assets/vendor/datatables.net-responsive-bs5/css/responsive.bootstrap5.min.css" rel="stylesheet" type="text/css" />
<link href="~/assets/vendor/datatables.net-fixedcolumns-bs5/css/fixedColumns.bootstrap5.min.css" rel="stylesheet" type="text/css" />
<link href="~/assets/vendor/datatables.net-fixedheader-bs5/css/fixedHeader.bootstrap5.min.css" rel="stylesheet" type="text/css" />
<link href="~/assets/vendor/datatables.net-buttons-bs5/css/buttons.bootstrap5.min.css" rel="stylesheet" type="text/css" />
<link href="~/assets/vendor/datatables.net-select-bs5/css/select.bootstrap5.min.css" rel="stylesheet" type="text/css" />

<!-- Select2 CSS + Bootstrap 5 Theme -->
<link href="~/assets/vendor/select2/css/select2.min.css" rel="stylesheet" type="text/css" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<!-- Theme Config Js -->
<script src="~/assets/js/config.js"></script>

<!-- App css -->
<link href="~/assets/css/app.min.css" rel="stylesheet" type="text/css" id="app-style" />

<!-- Icons css -->
<link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />

<div class="row p-2">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h3 class="page-title">@ViewData["Title"]</h3>
                <br />
                <div class="mb-3 d-flex gap-2 align-items-center">
                    <a href="@Url.Action("Create", "Menu")" class="btn btn-primary">
                        <i class="ri-file-list-line"></i> Create Menu
                    </a>

                    <div style="width: 250px;">
                        <select id="productFilter"
                                class="form-select"
                                data-placeholder="-- All Products --">
                            <option value=""></option>
                        </select>
                    </div>

                    <button id="resetFilter" class="btn btn-secondary">
                        <i class="ri-refresh-line"></i> Reset
                    </button>
                </div>

                <div class="table-responsive">
                    <table id="basic-datatable" class="table table-striped dt-responsive nowrap w-100">
                        <thead>
                            <tr>
                                <th>Menu Title</th>
                                <th>Parent Menu</th>
                                <th>Product</th>
                                <th>Active</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="menuEditModal" tabindex="-1" aria-labelledby="menuEditModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading page details...</p>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/vendor/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="~/assets/vendor/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
<script src="~/assets/vendor/datatables.net-select/js/dataTables.select.min.js"></script>
<script src="~/assets/vendor/datatables.net-keytable/js/dataTables.keyTable.min.js"></script>
<script src="~/assets/js/app.min.js"></script>
<script src="~/assets/vendor/select2/js/select2.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>

<script>
    // ── Select2 init ─────────────────────────────────────────
    $('#productFilter').select2({
        placeholder: '-- All Products --',
        allowClear: true,
        width: '100%'
    });

    // ── Populate products dropdown ────────────────────────────
    $.ajax({
        url: '/Page/GetProductsForFilter',
        type: 'GET',
        success: function (products) {
            products.forEach(function (p) {
                $('#productFilter').append(new Option(p.text, p.value, false, false));
            });
        }
    });

    // ── DataTable init ────────────────────────────────────────
    var table = $('#basic-datatable').DataTable({

        processing: true,
        serverSide: true,

        ajax: {
            url: '/Menu/GetPagesPaged',
            type: 'POST',

            data: function (d) {
                d.productId = $('#productFilter').val();
            }
        },

        columns: [

            // Menu Title
            {
                data: 'menuTitle',
                defaultContent: '-'
            },

            // Parent Menu
            {
                data: 'parentMenuTitle',
                render: function (data) {

                    return data && data.trim() !== ''
                        ? data
                        : '<span class="badge bg-warning">Main Menu</span>';
                }
            },

            // Product
            {
                data: 'productName',
                defaultContent: '-'
            },

            // Active Status
            {
                data: 'isActive',
                className: 'text-center',
                render: function (data) {

                    return data
                        ? '<span class="badge bg-success">Active</span>'
                        : '<span class="badge bg-danger">Inactive</span>';
                }
            },

            // Actions
            {
                data: 'id',
                orderable: false,
                searchable: false,
                className: 'text-center',

                render: function (data) {

                    return `
                        <div class="d-flex justify-content-center gap-1">

                            <!-- Edit -->
                            <button type="button"
                                    class="btn btn-sm btn-info edit-menu-btn"
                                    data-menu-id="${data}"
                                    title="Edit Menu">

                                <i class="bi bi-pencil"></i>

                            </button>

                            <!-- Delete -->
                            <button type="button"
                                    class="btn btn-sm btn-danger delete-menu-btn"
                                    data-menu-id="${data}"
                                    title="Delete Menu">

                                <i class="bi bi-trash"></i>

                            </button>

                        </div>
                    `;
                }
            }

        ],

        pageLength: 10,

        lengthMenu: [
            [10, 25, 50, 100],
            [10, 25, 50, 100]
        ],

        responsive: true,
        autoWidth: false,
        ordering: true,
        searching: true,
        paging: true,
        info: true

    });

    // ── Filter on product change ──────────────────────────────
    $('#productFilter').on('change', function () {
        table.ajax.reload();
    });

    // ── Reset button ──────────────────────────────────────────
    $('#resetFilter').on('click', function () {
        $('#productFilter').val(null);
        $('#productFilter').trigger('change');
        $('#productFilter').trigger('change.select2');
        table.search('').draw();
    });
</script>

<script>
    $(document).ready(function () {
        const menuEditModal = new bootstrap.Modal(document.getElementById('menuEditModal'));
        const modalContent = $('#menuEditModal .modal-content');

        $('#basic-datatable').on('click', '.edit-menu-btn', function () {
            const Id = $(this).data('menu-id');

            if (!Id) {
                alert("Menu ID is missing!");
                return;
            }

            modalContent.html(`
                <div class="modal-body text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading page details...</p>
                </div>
            `);

            menuEditModal.show();

            const url = '@Url.Action("LoadEditModal", "Menu")' + '?id=' + Id;

            $.ajax({
                url: url,
                type: 'GET',
                cache: false,
                success: function (partialViewHtml) {
                    modalContent.html(partialViewHtml);
                },
                error: function (xhr, status, error) {
                    console.error("AJAX error:", status, error);
                    modalContent.html(`
                        <div class="modal-header">
                            <h5 class="modal-title text-danger">Error Loading Data</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="m-0">Failed to load user details. Server responded with: ${xhr.status} (${xhr.statusText})</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    `);
                }
            });
        });
    });
</script>

<script>

    // ── Delete Menu ─────────────────────────────────────────
    $('#basic-datatable').on('click', '.delete-menu-btn', function () {

        const id = $(this).data('menu-id');

        // Validate ID
        if (!id) {

            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Menu ID not found.'
            });

            return;
        }

        // Confirmation Alert
        Swal.fire({

            title: 'Delete Menu?',
            text: 'This action cannot be undone.',
            icon: 'warning',

            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',

            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel'

        }).then((result) => {

            // Cancel
            if (!result.isConfirmed)
                return;

            // Loading
            Swal.fire({
                title: 'Deleting...',
                text: 'Please wait',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // AJAX Delete
            $.ajax({

                url: '/Menu/DeleteMenu',
                type: 'DELETE',

                data: {
                    id: id
                },

                success: function (response) {

                    Swal.close();

                    // Success
                    if (response.success) {

                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted',
                            text: response.message,
                            timer: 1500,
                            showConfirmButton: false
                        });

                        // Reload DataTable
                        table.ajax.reload(null, false);

                    }
                    else {

                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message || 'Failed to delete menu.'
                        });

                    }

                },

                error: function () {

                    Swal.fire({
                        icon: 'error',
                        title: 'Server Error',
                        text: 'Something went wrong while deleting.'
                    });

                }

            });

        });

    });

</script>