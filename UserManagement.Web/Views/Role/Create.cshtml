@model UserManagement.Data.Models.RoleModel

@{
    ViewData["Title"] = "Create Role";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="row p-2">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h3 class="header">@ViewData["Title"]</h3>
                    <br />
                    <form asp-action="Create" asp-controller="Role" method="post" id="RegisterForm" novalidate>
                        <fieldset>
                            <div class="row g-2">
                                <div class="mb-3 col-md-6 position-relative">
                                    <label asp-for="RoleName" class="form-label">Role Name</label>
                                    <input asp-for="RoleName" class="form-control round" required
                                           data-bs-toggle="tooltip" data-bs-placement="right" title="Role Name is required" />
                                    <span asp-validation-for="RoleName" class="invalid-tooltip">Role Name is required</span>
                                    <small id="roleName-status"></small>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="mb-3 col-md-6 position-relative">
                                    <label asp-for="Description" class="form-label">Description</label>
                                    <textarea asp-for="Description" class="form-control round" required
                                              data-bs-toggle="tooltip" data-bs-placement="right" title="Description is required"></textarea>
                                    <span asp-validation-for="Description" class="invalid-tooltip">Description is required</span>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="mb-3 col-md-2 position-relative">
                                    <label asp-for="IsActive" class="form-label">Active</label>
                                    <select asp-for="IsActive" class="form-select select2">
                                        <option value="true">Active</option>
                                        <option value="false">Inactive</option>
                                    </select>
                                    <span asp-validation-for="IsActive" class="invalid-tooltip">Active Status is required</span>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">Create Role</button>
                        </fieldset>
                    </form>
                </div> <!-- end card-body -->
            </div> <!-- end card-->
        </div> <!-- end col -->
    </div>
</div>
<!-- Load jQuery only ONCE -->
<script src="~/assets/lib/jquery/jquery.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>


<script>
    let roleNameValid = false;

    $("#RoleName").on('blur', function () {
    let roleName = $(this).val().trim();

        if (roleName.length < 2) {
            $("#roleName-status").html(`<span style="color:gray;">Minimum 2 characters required</span>`);
            roleNameValid = false;
            return;
        }

        $.ajax({
            url: '/Role/CheckRoleName',
            type: 'POST',
            data: { roleName: roleName },
            success: function (res) {
                if (res.exists) {
                    roleNameValid = false;
                    $("#roleName-status").html(`<span style="color:red;">❌ Role already exists</span>`);
                } else {
                    roleNameValid = true;
                    $("#roleName-status").html(`<span style="color:green;">✔ Role available</span>`);
                }
            }
        });
    });

    $("#RegisterForm").on("submit", function (e) {
        e.preventDefault();
        let form = $(this)[0];


        if (!roleNameValid) {
            Swal.fire({
                icon: 'error',
                title: 'Role Already Exists',
                text: 'Please choose another Role.'
            });
            return;
        }

        if (!form.checkValidity()) {
            $(this).addClass('was-validated');
            return;
        }
        Swal.fire({
            title: 'Create Role?',
            text: "Are you sure you want to create?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Save',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Saving...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                $.ajax({
                    url: '/Role/Create',
                    type: 'POST',
                    data: $("#RegisterForm").serialize(),
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: function (response) {
                        Swal.close();
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: response.message,
                                showConfirmButton: false,
                                timer: 1500
                            }).then(() => {
                                window.location.href = response.redirectUrl;
                                // Reset form and Select2 elements
                            });
                        } else if (response.redirectUrl) {
                            // Redirect if controller provides URL
                            window.location.href = response.redirectUrl;
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Failed to create role.'
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong! Please try again.'
                        });
                    }
                });
            }
        });
    });



</script>

