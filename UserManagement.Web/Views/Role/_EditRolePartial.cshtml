@using UserManagement.Data.Models
@model RoleModel

@{
    Layout = null;
}

<div class="modal-header">
    <h5 class="modal-title" id="userEditModalLabel">
        Edit Role: @Model.RoleName
    </h5>

    <button type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close">
    </button>
</div>

<form id="updateRoleForm"
      asp-action="LoadEditModal"
      asp-controller="Role"
      method="post"
      autocomplete="off"
      novalidate>

    <input type="hidden" asp-for="Id" />

    <div class="modal-body">

        <!-- Role Name -->
        <div class="mb-3 col-md-6">

            <label class="form-label">
                Role Name <span class="text-danger">*</span>
            </label>

            <input type="text"
                   asp-for="RoleName"
                   id="RoleName"
                   class="form-control"
                   autocomplete="off" />

            <small id="roleName-status"
                   class="text-danger validation-message d-none">
            </small>

        </div>

        <!-- Description -->
        <div class="mb-3 col-md-6">

            <label class="form-label">
                Description <span class="text-danger">*</span>
            </label>

            <textarea asp-for="Description"
                      id="Description"
                      class="form-control"
                      rows="4"
                      autocomplete="off">
            </textarea>

            <small id="description-status"
                   class="text-danger validation-message d-none">
            </small>

        </div>

        <!-- Status -->
        <div class="mb-3 col-md-3">

            <label class="form-label">
                Active
            </label>

            <select id="Status"
                    asp-for="IsActive"
                    class="form-select">

                <option value="true">Yes</option>
                <option value="false">No</option>

            </select>

        </div>

    </div>

    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                class="btn btn-primary">
            Save Changes
        </button>

    </div>

</form>

<style>

    .validation-message {
        font-size: 13px;
        margin-top: 4px;
        display: block;
    }

    .select2-container {
        width: 100% !important;
    }

</style>

<!-- jQuery -->
<script src="~/assets/lib/jquery/jquery.min.js"></script>

<!-- SweetAlert -->
<script src="~/assets/js/sweetalert2.all.min.js"></script>

<!-- Select2 -->
<script src="~/assets/vendor/select2/js/select2.min.js"></script>

<script>

    // ============================================
    // SELECT2 INIT
    // ============================================

    $(document).ready(function () {

        var modal = $("#updateRoleForm").closest(".modal");

        $("#Status").select2({
            placeholder: "Select Status",
            dropdownParent: modal,
            width: '100%'
        });

    });

    // ============================================
    // VALIDATION HELPERS
    // ============================================

    function showError(messageId, message) {

        $(messageId)
            .removeClass("d-none")
            .text(message);
    }

    function clearError(messageId) {

        $(messageId)
            .addClass("d-none")
            .text("");
    }

    // ============================================
    // EXISTING ROLE NAME
    // ============================================

    let originalRoleName = $("#RoleName").val().trim();

    let roleNameValid = true;

    // ============================================
    // ROLE NAME VALIDATION
    // ============================================

    $("#RoleName").on("keyup blur", function () {

        let roleName = $(this).val().trim();

        // Required
        if (roleName === "") {

            showError(
                "#roleName-status",
                "Role Name is required."
            );

            roleNameValid = false;

            return;
        }

        // Minimum length
        if (roleName.length < 2) {

            showError(
                "#roleName-status",
                "Minimum 2 characters required."
            );

            roleNameValid = false;

            return;
        }

        // Same old value
        if (roleName.toLowerCase() === originalRoleName.toLowerCase()) {

            clearError("#roleName-status");

            roleNameValid = true;

            return;
        }

        // Duplicate check
        $.ajax({

            url: "/Role/CheckRoleName",

            type: "POST",

            data: {
                roleName: roleName
            },

            success: function (res) {

                if (res.exists) {

                    showError(
                        "#roleName-status",
                        "Role already exists."
                    );

                    roleNameValid = false;

                }
                else {

                    clearError("#roleName-status");

                    roleNameValid = true;
                }

            },

            error: function () {

                showError(
                    "#roleName-status",
                    "Unable to validate role name."
                );

                roleNameValid = false;
            }

        });

    });

    // ============================================
    // DESCRIPTION VALIDATION
    // ============================================

    $("#Description").on("keyup blur", function () {

        let description = $(this).val().trim();

        if (description === "") {

            showError(
                "#description-status",
                "Description is required."
            );

            return;
        }

        if (description.length < 5) {

            showError(
                "#description-status",
                "Minimum 5 characters required."
            );

            return;
        }

        clearError("#description-status");

    });

    // ============================================
    // FORM SUBMIT
    // ============================================

    $("#updateRoleForm").on("submit", function (e) {

        e.preventDefault();

        let roleName = $("#RoleName").val().trim();

        let description = $("#Description").val().trim();

        let isValid = true;

        // ====================================
        // ROLE NAME VALIDATION
        // ====================================

        if (roleName === "") {

            showError(
                "#roleName-status",
                "Role Name is required."
            );

            isValid = false;
        }
        else if (roleName.length < 2) {

            showError(
                "#roleName-status",
                "Minimum 2 characters required."
            );

            isValid = false;
        }
        else if (!roleNameValid) {

            isValid = false;
        }
        else {

            clearError("#roleName-status");
        }

        // ====================================
        // DESCRIPTION VALIDATION
        // ====================================

        if (description === "") {

            showError(
                "#description-status",
                "Description is required."
            );

            isValid = false;
        }
        else if (description.length < 5) {

            showError(
                "#description-status",
                "Minimum 5 characters required."
            );

            isValid = false;
        }
        else {

            clearError("#description-status");
        }

        // ====================================
        // STOP IF INVALID
        // ====================================

        if (!isValid) {
            return;
        }

        // ====================================
        // CONFIRM UPDATE
        // ====================================

        Swal.fire({

            title: 'Update Role?',

            icon: 'warning',

            showCancelButton: true,

            confirmButtonText: 'Yes, Update',

            cancelButtonText: 'Cancel'

        }).then((result) => {

            if (!result.isConfirmed) {
                return;
            }

            Swal.fire({

                title: 'Updating...',

                allowOutsideClick: false,

                didOpen: () => {
                    Swal.showLoading();
                }

            });

            $.ajax({

                url: '/Role/LoadEditModal',

                type: 'POST',

                data: $("#updateRoleForm").serialize(),

                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                },

                success: function (response) {

                    Swal.close();

                    if (response.success) {

                        Swal.fire({

                            icon: 'success',

                            title: response.message,

                            showConfirmButton: false,

                            timer: 1500

                        }).then(() => {

                            window.location.href = response.redirectUrl;

                        });

                    }
                    else {

                        Swal.fire({

                            icon: 'error',

                            title: 'Error',

                            text: response.message || 'Failed to update role.'

                        });

                    }

                },

                error: function () {

                    Swal.fire({

                        icon: 'error',

                        title: 'Error',

                        text: 'Something went wrong! Please try again.'

                    });

                }

            });

        });

    });

</script>